NODE_ENV=production
PORT=5000
WEB_CONCURRENCY=2
COOKIE_SECURE=true
JOBS_PAUSED=true
# Standalone test input only; the Stack generates this URL from database_moving_in.
DATABASE_URL=postgresql://portal_db:REPLACE_FROM_THE_PROTECTED_CREDENTIAL@192.0.2.10:5432/portal_db?target_session_attrs=read-write&connect_timeout=3
DATABASE_SSL=false
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=example-portal-uploads
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=REPLACE_FROM_THE_PROTECTED_CREDENTIAL
S3_SECRET_ACCESS_KEY=REPLACE_FROM_THE_PROTECTED_CREDENTIAL
# UPLOAD_DIR is deliberately absent at the destination.
# Preserve required host-held secrets through the vault, outside this example file.
