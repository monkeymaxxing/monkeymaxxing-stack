PUBLIC_ORIGIN=https://portal.example.com
HOST=0.0.0.0
PORT=8001
WEB_CONCURRENCY=2
DATABASE_URL='postgresql://portal:REPLACE_WITH_DATABASE_PASSWORD@db01:5432,db02:5432/portal?target_session_attrs=read-write&connect_timeout=3'
S3_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=portal-documents
S3_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SECRET_ACCESS_KEY
APP_ENV=development
