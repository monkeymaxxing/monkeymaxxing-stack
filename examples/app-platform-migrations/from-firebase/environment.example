# Supply secrets through your deployment's protected environment file.
# The database URL lists every Stack database server. Passwords are URL-encoded.
DATABASE_URL=postgresql://portal:REPLACE_WITH_DATABASE_PASSWORD@db01:5432,db02:5432/portal?target_session_attrs=read-write&connect_timeout=3
PORT=8001
WEB_CONCURRENCY=2
S3_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=portal-private-documents
S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY
AUTH_ISSUER=urn:portal:password
APP_ENV=development
