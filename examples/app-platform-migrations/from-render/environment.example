# Example values only. Store actual values in a protected env file outside Git.
export DATABASE_URL='postgresql://portal:example-database-password@db01.example.com:5432,db02.example.com:5432/portal?target_session_attrs=read-write&connect_timeout=3'
export RESTORE_DATABASE_URL='postgresql://portal:example-database-password@db01.example.com:5432/portal?sslmode=disable'
export PORT=8001
export WEB_CONCURRENCY=2
export FILE_STORAGE=s3
export S3_ENDPOINT='https://s3.example.com'
export S3_REGION='us-east-1'
export S3_BUCKET='example-portal-documents'
export S3_ACCESS_KEY_ID='example-access-key'
export S3_SECRET_ACCESS_KEY='example-secret-key'
export MIGRATION_LIMIT=2
export APP_RELEASE=render-migration
export EXPORT_DIR='./migration-export'
# Set only for the disposable restore and object import after checking their targets.
export RESTORE_CONFIRM=isolated-destination
# Use development for a laptop, or staging for a separate staging database.
export APP_ENV=staging
export APP_URL='http://127.0.0.1:8001'
export REHEARSAL_CONFIRM=disposable-destination
# Supply FIXTURE_PASSWORD from its protected file when testing synthetic fixture accounts.
