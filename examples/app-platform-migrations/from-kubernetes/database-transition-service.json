{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "postgres-transition",
    "namespace": "portal"
  },
  "spec": {
    "type": "NodePort",
    "selector": {
      "app": "postgres"
    },
    "ports": [
      {
        "port": 5432,
        "targetPort": 5432,
        "nodePort": 30432
      }
    ],
    "externalTrafficPolicy": "Local"
  }
}
