{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "portal"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "portal-settings",
        "namespace": "portal"
      },
      "data": {
        "PORT": "8080",
        "WEB_CONCURRENCY": "2",
        "NODE_ENV": "production",
        "COOKIE_SECURE": "false",
        "UPLOADS_DIR": "/uploads",
        "DATABASE_URL_FILE": "/run/portal-secrets/database-url"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "postgres-data",
        "namespace": "portal"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "local-path",
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "private-uploads",
        "namespace": "portal"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "storageClassName": "local-path",
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "postgres",
        "namespace": "portal"
      },
      "spec": {
        "serviceName": "postgres",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "postgres"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "postgres"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "postgres",
                "image": "docker.io/library/postgres:15.19-bookworm@sha256:19b8449e2187e8a174b40c8832a7ed9da45813b74c2779b1c614e7e7d0ee47f0",
                "args": [
                  "-c",
                  "wal_level=logical",
                  "-c",
                  "max_wal_senders=10",
                  "-c",
                  "max_replication_slots=10",
                  "-c",
                  "wal_sender_timeout=4s"
                ],
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "portal"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "portal"
                  },
                  {
                    "name": "POSTGRES_PASSWORD_FILE",
                    "value": "/run/portal-secrets/postgres-password"
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  },
                  {
                    "name": "secrets",
                    "mountPath": "/run/portal-secrets",
                    "readOnly": true
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "pg_isready",
                      "-U",
                      "portal",
                      "-d",
                      "portal"
                    ]
                  },
                  "initialDelaySeconds": 3,
                  "periodSeconds": 2
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "postgres-data"
                }
              },
              {
                "name": "secrets",
                "secret": {
                  "secretName": "portal-runtime"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "postgres",
        "namespace": "portal"
      },
      "spec": {
        "selector": {
          "app": "postgres"
        },
        "ports": [
          {
            "port": 5432,
            "targetPort": 5432
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "web",
        "namespace": "portal"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "web"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "web"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000
            },
            "containers": [
              {
                "name": "web",
                "image": "localhost/kubernetes-portal:proof",
                "imagePullPolicy": "Never",
                "command": [
                  "node",
                  "server.mjs"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "portal-settings"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "uploads",
                    "mountPath": "/uploads"
                  },
                  {
                    "name": "secrets",
                    "mountPath": "/run/portal-secrets",
                    "readOnly": true
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 2
                }
              }
            ],
            "volumes": [
              {
                "name": "uploads",
                "persistentVolumeClaim": {
                  "claimName": "private-uploads"
                }
              },
              {
                "name": "secrets",
                "secret": {
                  "secretName": "portal-runtime"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "worker",
        "namespace": "portal"
      },
      "spec": {
        "replicas": 0,
        "selector": {
          "matchLabels": {
            "app": "worker"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "worker"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "securityContext": {
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000
            },
            "containers": [
              {
                "name": "worker",
                "image": "localhost/kubernetes-portal:proof",
                "imagePullPolicy": "Never",
                "command": [
                  "node",
                  "jobs.mjs"
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "portal-settings"
                    }
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "uploads",
                    "mountPath": "/uploads"
                  },
                  {
                    "name": "secrets",
                    "mountPath": "/run/portal-secrets",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "uploads",
                "persistentVolumeClaim": {
                  "claimName": "private-uploads"
                }
              },
              {
                "name": "secrets",
                "secret": {
                  "secretName": "portal-runtime"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "web",
        "namespace": "portal"
      },
      "spec": {
        "selector": {
          "app": "web"
        },
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "portal",
        "namespace": "portal"
      },
      "spec": {
        "ingressClassName": "traefik",
        "rules": [
          {
            "host": "portal.example.com",
            "http": {
              "paths": [
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "web",
                      "port": {
                        "number": 8080
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "session-cleanup",
        "namespace": "portal"
      },
      "spec": {
        "schedule": "0 * * * *",
        "timeZone": "Etc/UTC",
        "concurrencyPolicy": "Forbid",
        "suspend": true,
        "jobTemplate": {
          "spec": {
            "template": {
              "spec": {
                "restartPolicy": "Never",
                "securityContext": {
                  "runAsUser": 1000
                },
                "containers": [
                  {
                    "name": "cleanup",
                    "image": "localhost/kubernetes-portal:proof",
                    "imagePullPolicy": "Never",
                    "command": [
                      "node",
                      "schedule.mjs"
                    ],
                    "envFrom": [
                      {
                        "configMapRef": {
                          "name": "portal-settings"
                        }
                      }
                    ],
                    "volumeMounts": [
                      {
                        "name": "secrets",
                        "mountPath": "/run/portal-secrets",
                        "readOnly": true
                      }
                    ]
                  }
                ],
                "volumes": [
                  {
                    "name": "secrets",
                    "secret": {
                      "secretName": "portal-runtime"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
