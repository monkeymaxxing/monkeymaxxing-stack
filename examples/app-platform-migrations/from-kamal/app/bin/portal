#!/usr/bin/env ruby
# Bundler can restart Ruby to select the locked Bundler version. Load it before
# consuming ARGV so a restart cannot discard the requested command.
require_relative "../config/boot"
ENV["RAILS_ENV"] ||= "production"
command = ARGV.shift
if command == "seed-test-data" && !["development", "staging"].include?(ENV["APP_ENV"])
  abort "seed-test-data refuses to run: APP_ENV must be development or staging, so production never gets test data"
end
if command == "web"
  exec "bundle", "exec", "puma", "-C", "config/puma.rb"
elsif command == "migrate"
  # Deploy runs one migration process before web/jobs. Rails serializes concurrent
  # migration runners with its PostgreSQL advisory lock; use a direct connection.
  exec "bundle", "exec", "rake", "db:migrate"
else
  require_relative "../config/environment"
  case command
  when "jobs"
    require_relative "../lib/report_worker"
    ReportWorker.run
  when "clock"
    require_relative "../lib/session_schedule"
    SessionSchedule.run
  when "schedule-once"
    require_relative "../lib/session_schedule"
    SessionSchedule.tick
  when "seed-test-data"
    require_relative "../lib/seed_test_data"
    SeedTestData.run(ARGV)
  else
    abort "usage: bin/portal web|migrate|jobs|clock|schedule-once|seed-test-data"
  end
end
