{
  "name": "stack-vercel-exit-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "next build --webpack && node scripts/package-runtime.mjs",
    "web": "node .next/standalone/scripts/web.mjs",
    "migrate": "node scripts/manage.mjs migrate",
    "jobs": "node scripts/manage.mjs jobs",
    "seed-test-data": "node scripts/manage.mjs seed-test-data",
    "test": "node --test tests/*.test.mjs",
    "export-snapshot": "node scripts/export-snapshot.mjs",
    "import-snapshot": "node scripts/import-snapshot.mjs",
    "test-rehearsal": "node tests/rehearsal.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@better-auth/utils": "0.4.2"
  }
}
