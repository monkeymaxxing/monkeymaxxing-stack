FROM docker.io/library/node:24.22.2-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend ./frontend
RUN npm run build

FROM docker.io/library/node:24.22.2-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY --chown=node:node database.mjs pg_with_multiple_database_servers.mjs server.mjs web.mjs storage.mjs jobs.mjs jobs_runner.mjs password_resets.mjs seed_test_data.mjs ./
COPY --chown=node:node migrations ./migrations
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node web/reset-password.html ./web/reset-password.html
COPY --from=frontend --chown=node:node /app/web/client ./web/client
USER node
EXPOSE 8001
CMD ["node", "web.mjs"]
