# Keep real values in a mode-600 env file outside the code checkout.
DATABASE_URL=postgresql://portal:replace-password@127.0.0.1:5432/portal
PORT=8001
WEB_CONCURRENCY=2
APP_ENV=development
PUBLIC_APP_URL=https://portal.example.com
MAIL_FROM=portal@example.com
SMTP_URL=smtps://replace-user:replace-password@smtp.example.com:465
AUTH_MIGRATION_MODE=reset-required
NETLIFY_EXPORT_DIR=/absolute/path/to/private-export
S3_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=private-documents
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=replace-access-key
S3_SECRET_ACCESS_KEY=replace-secret-key
# The object importer also accepts these standard AWS credential names.
AWS_ACCESS_KEY_ID=replace-access-key
AWS_SECRET_ACCESS_KEY=replace-secret-key
# Staging only: use APP_ENV=staging and this protected directory instead of SMTP_URL.
# PASSWORD_RESET_EMAIL_DIR=/absolute/path/to/private-mail-sink
