{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Synthetic ECS Fargate migration source. Small disposable resources; no load balancer or NAT gateway.",
  "Parameters": {
    "ImageUri": {
      "Type": "String",
      "AllowedPattern": ".+@sha256:[a-f0-9]{64}"
    },
    "DatabaseEngineVersion": {
      "Type": "String",
      "Description": "An available RDS PostgreSQL 17 minor version in this region"
    },
    "OperatorCidr": {
      "Type": "String",
      "Description": "The test operator public IPv4 /32; synthetic HTTP traffic only",
      "AllowedPattern": "[0-9.]+/32"
    },
    "WebCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    },
    "WorkerCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        1
      ]
    }
  },
  "Resources": {
    "Network": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.83.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "SubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.83.1.0/24",
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "SubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": "10.83.2.0/24",
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "RouteA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetA"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "RouteB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "SubnetB"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "TaskNetwork": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Fixture portal from operator IPv4 only",
        "VpcId": {
          "Ref": "Network"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "CidrIp": {
              "Ref": "OperatorCidr"
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "DatabaseNetwork": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Private PostgreSQL from fixture tasks only",
        "VpcId": {
          "Ref": "Network"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "TaskNetwork"
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Two source fixture subnets",
        "SubnetIds": [
          {
            "Ref": "SubnetA"
          },
          {
            "Ref": "SubnetB"
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "DatabaseParameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "Logical replication prepared before initial RDS boot",
        "Family": "postgres17",
        "Parameters": {
          "rds.logical_replication": "1",
          "wal_sender_timeout": "4000"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "DatabaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-database"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"postgres\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceIdentifier": {
          "Fn::Sub": "${AWS::StackName}-database"
        },
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "DatabaseEngineVersion"
        },
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "portal",
        "MasterUsername": {
          "Fn::Sub": "{{resolve:secretsmanager:${DatabaseSecret}:SecretString:username}}"
        },
        "MasterUserPassword": {
          "Fn::Sub": "{{resolve:secretsmanager:${DatabaseSecret}:SecretString:password}}"
        },
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "DBParameterGroupName": {
          "Ref": "DatabaseParameters"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseNetwork"
          }
        ],
        "PubliclyAccessible": false,
        "MultiAZ": false,
        "BackupRetentionPeriod": 0,
        "DeletionProtection": false,
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      },
      "DeletionPolicy": "Delete",
      "UpdateReplacePolicy": "Delete"
    },
    "SecretAttachment": {
      "Type": "AWS::SecretsManager::SecretTargetAttachment",
      "Properties": {
        "SecretId": {
          "Ref": "DatabaseSecret"
        },
        "TargetId": {
          "Ref": "Database"
        },
        "TargetType": "AWS::RDS::DBInstance"
      }
    },
    "Uploads": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "FailedNotifications": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${AWS::StackName}-failed"
        },
        "MessageRetentionPeriod": 1209600,
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "Notifications": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${AWS::StackName}-reports"
        },
        "VisibilityTimeout": 60,
        "ReceiveMessageWaitTimeSeconds": 1,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "FailedNotifications",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/ecs/${AWS::StackName}"
        },
        "RetentionInDays": 1,
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": {
          "Ref": "AWS::StackName"
        },
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadFixtureDatabase",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "AppDatabaseSecret"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ],
        "RoleName": {
          "Fn::Sub": "${AWS::StackName}-execution"
        }
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "FixtureBytesAndNotifications",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Uploads",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Uploads.Arn}/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage",
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:ChangeMessageVisibility",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Notifications",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ],
        "RoleName": {
          "Fn::Sub": "${AWS::StackName}-task"
        }
      }
    },
    "WebTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-webtask"
        },
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "portal",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "Command": [
              "node",
              "server.mjs"
            ],
            "StopTimeout": 30,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "PORT",
                "Value": "8080"
              },
              {
                "Name": "WEB_CONCURRENCY",
                "Value": "1"
              },
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "COOKIE_SECURE",
                "Value": "false"
              },
              {
                "Name": "QUEUE_BACKEND",
                "Value": "sqs"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "BUCKET_NAME",
                "Value": {
                  "Ref": "Uploads"
                }
              },
              {
                "Name": "SQS_QUEUE_URL",
                "Value": {
                  "Ref": "Notifications"
                }
              },
              {
                "Name": "PGSSLMODE",
                "Value": "verify-full"
              },
              {
                "Name": "PGHOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "PGPORT",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Port"
                  ]
                }
              },
              {
                "Name": "PGDATABASE",
                "Value": "portal"
              }
            ],
            "Secrets": [
              {
                "Name": "PGUSER",
                "ValueFrom": {
                  "Fn::Sub": "${AppDatabaseSecret}:username::"
                }
              },
              {
                "Name": "PGPASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${AppDatabaseSecret}:password::"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "webtask"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      },
      "DependsOn": "SecretAttachment"
    },
    "WorkerTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-workertask"
        },
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "portal",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "Command": [
              "node",
              "jobs.mjs"
            ],
            "StopTimeout": 30,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "PORT",
                "Value": "8080"
              },
              {
                "Name": "WEB_CONCURRENCY",
                "Value": "1"
              },
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "COOKIE_SECURE",
                "Value": "false"
              },
              {
                "Name": "QUEUE_BACKEND",
                "Value": "sqs"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "BUCKET_NAME",
                "Value": {
                  "Ref": "Uploads"
                }
              },
              {
                "Name": "SQS_QUEUE_URL",
                "Value": {
                  "Ref": "Notifications"
                }
              },
              {
                "Name": "PGSSLMODE",
                "Value": "verify-full"
              },
              {
                "Name": "PGHOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "PGPORT",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Port"
                  ]
                }
              },
              {
                "Name": "PGDATABASE",
                "Value": "portal"
              }
            ],
            "Secrets": [
              {
                "Name": "PGUSER",
                "ValueFrom": {
                  "Fn::Sub": "${AppDatabaseSecret}:username::"
                }
              },
              {
                "Name": "PGPASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${AppDatabaseSecret}:password::"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "workertask"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      },
      "DependsOn": "SecretAttachment"
    },
    "ScheduleTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "${AWS::StackName}-scheduletask"
        },
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "portal",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "Command": [
              "node",
              "schedule.mjs"
            ],
            "StopTimeout": 30,
            "PortMappings": [
              {
                "ContainerPort": 8080,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "PORT",
                "Value": "8080"
              },
              {
                "Name": "WEB_CONCURRENCY",
                "Value": "1"
              },
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "COOKIE_SECURE",
                "Value": "false"
              },
              {
                "Name": "QUEUE_BACKEND",
                "Value": "sqs"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "BUCKET_NAME",
                "Value": {
                  "Ref": "Uploads"
                }
              },
              {
                "Name": "SQS_QUEUE_URL",
                "Value": {
                  "Ref": "Notifications"
                }
              },
              {
                "Name": "PGSSLMODE",
                "Value": "verify-full"
              },
              {
                "Name": "PGHOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "PGPORT",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Port"
                  ]
                }
              },
              {
                "Name": "PGDATABASE",
                "Value": "portal"
              }
            ],
            "Secrets": [
              {
                "Name": "PGUSER",
                "ValueFrom": {
                  "Fn::Sub": "${AppDatabaseSecret}:username::"
                }
              },
              {
                "Name": "PGPASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${AppDatabaseSecret}:password::"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "scheduletask"
              }
            }
          }
        ],
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      },
      "DependsOn": "SecretAttachment"
    },
    "Web": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": {
          "Fn::Sub": "${AWS::StackName}-web"
        },
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "WebTask"
        },
        "DesiredCount": {
          "Ref": "WebCount"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Ref": "SubnetA"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "TaskNetwork"
              }
            ]
          }
        },
        "PropagateTags": "SERVICE",
        "Tags": [
          {
            "Key": "project",
            "Value": "ecs-migration-example"
          }
        ]
      }
    },
    "Worker": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": {
          "Fn::Sub": "${AWS::StackName}-worker"
        },
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "WorkerTask"
        },
