FROM docker.io/library/golang:1.27.4-trixie@sha256:b54b2639de8c1bfe538ec5ffc45f29b1932235ac5f6d63c059853646677112d9 AS build
WORKDIR /source
COPY go.mod go.sum ./
RUN go mod download
COPY *.go ./
COPY migrations/ migrations/
COPY scripts/replica_report.go scripts/replica_report.go
ARG RELEASE
RUN test -n "$RELEASE" && CGO_ENABLED=0 go build -trimpath -ldflags "-X main.release=$RELEASE" -o /image/usr/local/bin/customer_portal .
RUN CGO_ENABLED=0 go build -trimpath -o /image/usr/local/bin/replica_report ./scripts/replica_report.go
RUN mkdir -p /image/app/assets
FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
COPY --from=build /image/ /
WORKDIR /app
USER nonroot
CMD ["customer_portal", "web"]
