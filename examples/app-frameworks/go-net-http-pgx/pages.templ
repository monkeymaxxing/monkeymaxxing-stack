package main

import "strconv"

// The pages are templ templates: `go generate` turns this file into
// pages_templ.go, which is committed so that a build needs no templ.

templ landingPage() {
	<!doctype html>
	<html lang="en"><meta charset="utf-8"/><title>Customer portal</title>
		<h1>Customer portal</h1><p>Keep private records and documents, and request a record-count report.</p>
		<h2>Log in</h2><form method="post" action="/login"><label>Email <input name="email" type="email" required autocomplete="username"/></label><label>Password <input name="password" type="password" minlength="12" maxlength="72" required autocomplete="current-password"/></label><button>Log in</button></form>
		<h2>Create an account</h2><form method="post" action="/register"><label>Email <input name="email" type="email" required autocomplete="username"/></label><label>Password (12 to 72 bytes) <input name="password" type="password" minlength="12" maxlength="72" required autocomplete="new-password"/></label><button>Create account</button></form>
	</html>
}

templ portalPage(data pageData) {
	<!doctype html>
	<html lang="en"><meta charset="utf-8"/><title>Your customer portal</title>
		<h1>Your records</h1><form method="post" action="/logout"><button>Log out</button></form>
		<ul>
			for _, item := range data.Records {
				<li><form method="post" action={ templ.URL("/records/" + strconv.FormatInt(item.ID, 10) + "/update") }><label>Title <input name="title" value={ item.Title } maxlength="200" required/></label><label>Description <textarea name="description">{ item.Description }</textarea></label><button>Save</button></form><form method="post" action={ templ.URL("/records/" + strconv.FormatInt(item.ID, 10) + "/delete") }><button>Delete { item.Title }</button></form></li>
			}
			if len(data.Records) == 0 {
				<li>No records yet.</li>
			}
		</ul>
		<h2>Add a record</h2><form method="post" action="/records"><label>Title <input name="title" maxlength="200" required/></label><label>Description <textarea name="description"></textarea></label><button>Add record</button></form>
		<h2>Upload a private document</h2><form method="post" action="/documents" enctype="multipart/form-data"><label>File, up to 5 MiB <input name="file" type="file" required/></label><button>Upload</button></form>
		<ul>
			for _, item := range data.Documents {
				<li><a href={ templ.URL("/documents/" + strconv.FormatInt(item.ID, 10)) }>Download { item.FileName }</a></li>
			}
			if len(data.Documents) == 0 {
				<li>No documents yet.</li>
			}
		</ul>
		<h2>Reports</h2><form method="post" action="/reports"><button>Request record-count report</button></form>
		<ul>
			for _, item := range data.Reports {
				<li>
					Report { strconv.FormatInt(item.ID, 10) }:
					if item.Output != nil {
						<pre>{ *item.Output }</pre>
					} else {
						Waiting for a worker. Refresh to check completion.
					}
				</li>
			}
			if len(data.Reports) == 0 {
				<li>No reports yet.</li>
			}
		</ul>
	</html>
}
