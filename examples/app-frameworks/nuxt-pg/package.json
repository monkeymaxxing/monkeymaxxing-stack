{
  "name": "nuxt-pg-customer-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "nuxt build",
    "check": "nuxt prepare && node --check lib/portal.mjs && node --check scripts/web.mjs && node --check scripts/manage.mjs",
    "start": "node scripts/web.mjs",
    "migrate": "node scripts/manage.mjs migrate",
    "jobs": "node scripts/manage.mjs jobs",
    "seed-test-data": "node scripts/manage.mjs seed-test-data",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "bcryptjs": "3.0.3",
    "pg": "8.23.1",
    "mime-types": "3.0.2"
  },
  "devDependencies": {
    "nuxt": "4.6.4",
    "h3": "1.15.11"
  }
}
