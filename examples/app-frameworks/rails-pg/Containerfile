FROM docker.io/library/ruby:3.4.7-slim-trixie@sha256:93dd13e28987e373857fbda4a7f4ae99e9f7acb6fcc266035e551229974d1c89
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev libyaml-dev && apt-get clean
COPY Gemfile Gemfile.lock ./
RUN bundle config set deployment true && bundle install
COPY . .
RUN RAILS_ENV=production SECRET_KEY_BASE=build-only-not-a-runtime-key APP_ORIGIN=https://portal.example.com bundle exec rake assets:precompile && useradd --uid 1000 --create-home portal && chown -R portal:portal /app
USER portal
ENV RAILS_ENV=production
CMD ["bin/portal", "web"]
