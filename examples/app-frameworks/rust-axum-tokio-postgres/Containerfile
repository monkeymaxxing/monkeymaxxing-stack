# Build context is this example directory; migrations are included locally.
# The reviewed builder and runtime are pinned by digest.
ARG RUST_BUILD_IMAGE=docker.io/library/rust:1.99.1-trixie@sha256:09027f873d45b8ecd1dc86f1fa13b7a62b875c961f017a0e331267b350430137
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot@sha256:08476c244888bfb425bae1ae4dd7c17f093e972aab8426883d97f3c6f280f7c1
FROM ${RUST_BUILD_IMAGE} AS build
WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY src/ src/
COPY examples/replica_report.rs examples/replica_report.rs
COPY templates/ templates/
COPY migrations/ migrations/
ARG RELEASE
RUN test -n "$RELEASE" && RELEASE="$RELEASE" cargo build --locked --release --examples --bins
RUN mkdir -p /image/app/assets && cp target/release/customer_portal /image/customer_portal && cp target/release/examples/replica_report /image/replica_report
# The runtime supplies glibc, libgcc, and CA certificates. S3 uses rustls.
FROM ${RUNTIME_IMAGE}
COPY --from=build /image/customer_portal /usr/local/bin/customer_portal
COPY --from=build /image/replica_report /usr/local/bin/replica_report
COPY --from=build /image/app /app
WORKDIR /app
USER 65532:65532
CMD ["customer_portal", "web"]
