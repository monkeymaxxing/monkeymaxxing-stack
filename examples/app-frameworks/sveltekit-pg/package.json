{
  "name": "sveltekit-pg-customer-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings",
    "start": "node scripts/web.mjs",
    "migrate": "node scripts/manage.mjs migrate",
    "jobs": "node scripts/manage.mjs jobs",
    "seed-test-data": "node scripts/manage.mjs seed-test-data",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "bcryptjs": "3.0.3",
    "pg": "8.23.1",
    "mime-types": "3.0.2"
  },
  "devDependencies": {
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "vite": "8.3.5",
    "typescript": "6.0.3",
    "@opentelemetry/api": "1.10.0",
    "svelte-check": "4.7.8"
  }
}
