#!/usr/bin/env python3
import os,sys
os.environ.setdefault("DJANGO_SETTINGS_MODULE", "portal.settings")
# Invoked from the app root, so each command uses the same import path.
sys.path.insert(0, os.getcwd())
command = sys.argv[1] if len(sys.argv) >= 2 else ""
if command == "web":
    os.execvp("gunicorn", ["gunicorn", "--config", "gunicorn.conf.py", "portal.wsgi:application"])
elif command == "migrate":
    import django
    django.setup()
    from django.db import connection, transaction
    from django.core.management import call_command
    # Transaction lock serializes concurrent deploy commands, without a session lock.
    # Framework migrations remain independently ordered and transactional.
    with transaction.atomic():
        with connection.cursor() as cursor:
            cursor.execute("SELECT pg_advisory_xact_lock(1465014610)")
        call_command("migrate", interactive=False)
elif command in ("jobs", "seed-test-data"):
    from django.core.management import execute_from_command_line
    execute_from_command_line([sys.argv[0], command.replace("-", "_"), *sys.argv[2:]])
else:
    raise SystemExit("usage: bin/portal web|migrate|jobs|seed-test-data")
