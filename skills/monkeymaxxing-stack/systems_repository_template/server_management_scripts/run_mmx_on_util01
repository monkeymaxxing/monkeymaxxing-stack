#!/usr/bin/env bash
# Run MMX on util01 at the clean, pushed main commit of the systems desk.
set -euo pipefail
cd "$(dirname "$0")/.."
fail() { printf 'run_mmx_on_util01: %s; nothing ran\n' "$*" >&2; exit 1; }
[ "$#" -gt 0 ] || fail 'give MMX arguments, such as run every_server'
address=$(mmx nodes --json | jq -er '.nodes[] | select(.name == "util01") | .address') || fail 'cannot find util01 in the inventory'
# status, stop, and results read or stop a run that may hold the lock, so
# they skip the lock and the commit check: they change no setting.
commit=none
case $1 in
  status|stop|results) ;;
  *)
    changes=$(git status --porcelain) || fail "git status failed"
    [ -z "$changes" ] || fail 'commit the working tree changes first'
    git fetch --quiet origin main || fail 'git fetch origin main failed'
    [ "$(git symbolic-ref --quiet --short HEAD)" = main ] || fail 'check out main first'
    commit=$(git rev-parse HEAD)
    # main moves without the desk: the triage agent pushes its notes, and
    # replace_failed_servers and destroy_replaced_servers push commits.
    [ "$commit" = "$(git rev-parse refs/remotes/origin/main)" ] || fail 'HEAD must equal pushed main: run git pull --rebase, and push your own commits if any, then run this again'
    printf 'run_mmx_on_util01: %s on util01 at %s\n' "$*" "$commit" >&2 ;;
esac
# Bash quoting keeps spaces and shell characters in MMX arguments literal.
ssh -F ssh/config "root@$address" "bash -s -- $(printf '%q ' "$commit" "$@")" <<'REMOTE'
set -euo pipefail
commit=$1; shift
# Ask MMHotline before taking the lock: MMHotline's check takes the lock
# itself and waits for it without a time limit, so a check made while
# holding the lock would wait forever. MMHotline trusts every commit on
# origin (mmhotline_settings.yml, trusted_commits), fetches, and moves its
# checkout forward to the commit. The helper never moves the checkout.
if [ "$commit" != none ]; then
  status=0
  answer=$(mmhotline commit-reviews check --commit-id "$commit" --json) || status=$?
  if [ "$status" -gt 1 ] || ! jq -e '.commit_check.trusted_through_commit_id | select(. != "")' <<< "$answer" > /dev/null 2>&1; then
    printf 'run_mmx_on_util01: MMHotline did not answer the commit check (exit %s), so nobody can tell whether util01 may run %s; nothing ran. On util01, systemctl status mmhotline says why.\n' "$status" "${commit:0:12}" >&2
    exit 1
  fi
fi
exec sudo -H -u mmhotline bash -c '
set -euo pipefail
commit=$1; shift
cd /var/lib/mmhotline/systems_repository
export MMX_VAULT_PASSWORD_FILE=/var/lib/mmhotline/mmx_vault_passphrase
case $1 in
  status|stop) command=$1; shift; exec mmx "$command" --non-interactive "$@" ;;
  results) exec mmx "$@" ;;
esac
exec 9>> /var/lib/mmhotline/systems_repository.lock
# While the lock is busy, say every minute who holds it and how to stop
# that run; re-read the holder, because the holder can change.
if ! flock --nonblock 9; then
  minutes=0
  while true; do
    holder=$(cat /var/lib/mmhotline/systems_repository.lock)
    case $minutes in
      0) waited= ;;
      1) waited=" (waited 1 minute)" ;;
      *) waited=" (waited $minutes minutes)" ;;
    esac
    printf "run_mmx_on_util01: waiting for util01'"'"'s lock%s. Lock holder: %s. If the holder is an MMX run, ./server_management_scripts/run_mmx_on_util01 status shows its run ID; if this change is urgent, ./server_management_scripts/run_mmx_on_util01 stop RUN_ID stops that run.\n" "$waited" "${holder:-another process on util01 (no holder line)}" >&2
    flock --wait 60 9 && break
    minutes=$((minutes + 1))
  done
fi
# Redirection empties the previous holder line. Quoting keeps one line.
printf -v mmx_arguments "%q " "$@"
printf "run_mmx_on_util01: mmx %s; user %s; process %s; started %s\n" "$mmx_arguments" "$(id -un)" "$$" "$(date -u +%FT%TZ)" > /var/lib/mmhotline/systems_repository.lock
changes=$(git status --porcelain)
[ -z "$changes" ] || { echo "util01 has uncommitted changes; nothing ran" >&2; exit 1; }
[ "$(git symbolic-ref --quiet --short HEAD)" = main ] || { echo "util01 must be on main; nothing ran" >&2; exit 1; }
# MMHotline moved the checkout to the commit. A newer push that
# MMHotline trusts can move it past the desk commit: pull on the desk first.
[ "$(git rev-parse HEAD)" = "$commit" ] || { echo "util01 is at $(git rev-parse --short=12 HEAD), not at the systems desk commit ${commit:0:12}; pull on the systems desk and run again; nothing ran" >&2; exit 1; }
command=$1; shift
case $command in
  run|dryrun|resume|run-command|check-one-time-playbooks|complete-one-time-playbook)
    exec mmx "$command" --non-interactive "$@" ;;
  *) exec mmx "$command" "$@" ;;
esac
' run_mmx_on_util01 "$commit" "$@"
REMOTE
