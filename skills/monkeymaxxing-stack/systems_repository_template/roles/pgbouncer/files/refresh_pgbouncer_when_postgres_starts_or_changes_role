#!/bin/bash
# Brings PgBouncer up to date with its Postgres after Postgres started,
# became a standby, or was promoted. PgBouncer keeps telling each new client
# what Postgres reported at PgBouncer's first connection to it, such as
# whether it is a standby, until a restart.
#
# Usage: refresh_pgbouncer_when_postgres_starts_or_changes_role DATA_DIRECTORY
#
# refresh_pgbouncer_when_postgres_starts_or_changes_role.path starts it, as
# root, through its service.
#
# 1. It waits, at most 60 seconds, until Postgres answers and its answer
#    agrees with standby.signal in the data directory: at a promotion,
#    Postgres deletes the file before it leaves recovery, and a connection
#    in that moment still reports a standby. The wait also takes a burst of
#    changes together, as when an old primary comes back as a standby.
#    On a primary it also waits until default_transaction_read_only is
#    off: pg_autoctl turns it on before a switchover and off only about a
#    second after the promotion (1.1 and 1.6 seconds on test servers), and
#    PgBouncer tells each new client what its first server connection
#    reported, which libpq's target_session_attrs=read-write reads. A
#    restart in that second left every libpq client "read-only" through
#    that PgBouncer until its next restart.
# 2. It restarts PgBouncer, on a standby and on a primary alike, so its
#    clients connect again and PgBouncer asks Postgres afresh: a driver that
#    wants writes finds the primary elsewhere, or here on a new primary.
#    RECONNECT on the admin console, which keeps the clients, isn't enough:
#    on test servers with PgBouncer 1.25.1, clients that logged in after it
#    still got the old in_hot_standby, so libpq (Rails, Django, PHP) found no
#    primary through PgBouncer until a restart, which fixed it in 0.34
#    seconds and 3 failed requests. The unit's TimeoutStopSec=10s bounds how
#    long a restart waits for the transactions in flight.
#
# A PgBouncer that someone stopped stays stopped.
set -uo pipefail

data_directory="$1"

if ! systemctl is-active --quiet pgbouncer.service; then
  exit 0
fi

as_postgres() {
  runuser -u postgres -- "$@"
}

answer=""
for second in $(seq 60); do
  # A standby answers "t on" or "t off"; a primary that takes writes "f off".
  if [ -e "$data_directory/standby.signal" ]; then expected=t; else expected="f off"; fi
  answer=$(as_postgres env PGCONNECT_TIMEOUT=2 psql -X -At -F ' ' -h /var/run/postgresql -p 5432 -d postgres -c "select pg_is_in_recovery(), current_setting('default_transaction_read_only')" 2>/dev/null) || answer=""
  in_recovery=${answer%% *}
  if [ "$expected" = t ] && [ "$in_recovery" = t ]; then
    break
  fi
  if [ "$answer" = "$expected" ]; then
    break
  fi
  sleep 1
done

case "$answer" in
  "t "*) state='is a standby' ;;
  "f off") state='is a primary' ;;
  "f on") state='is a primary, but its default_transaction_read_only stayed on for 60 seconds' ;;
  *) state='did not answer within 60 seconds' ;;
esac
printf 'Postgres %s: restarting PgBouncer, so its clients connect again\n' "$state"
exec systemctl try-restart pgbouncer.service
