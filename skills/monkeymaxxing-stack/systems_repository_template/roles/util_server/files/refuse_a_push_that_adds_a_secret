#!/bin/bash
# Managed by MMX from roles/util_server. The pre-receive hook of the team's
# main copy of the systems repository on util01: it refuses a push whose
# commits add what looks like a secret, such as a key or a password in
# plain text. Every push to main passes here: a desk's
# publish-branch-to-main, MMHotline's push of the triage agent's notes, and
# a server replacement's inventory commit.
#
# gitleaks (Debian's package) reads every commit of the push, each one's
# whole diff, so a secret that one commit adds and a later commit of the
# same push removes is refused too: it would stay in the history. -m in
# --log-opts gives a merge commit's diff against each parent too, so a
# secret added while resolving a merge conflict is refused as well: git
# log -p shows no diff for a merge without it. The
# check runs before Git changes main, while the pushed commits wait in
# quarantine, so a refused push changes nothing.
#
# A new branch's commits are the ones no branch holds yet. A deleted branch
# has none, and the main copy refuses a deletion anyway
# (receive.denyDeletes).
#
# A line that only looks like a secret, such as a documentation example,
# passes with a comment that holds gitleaks:allow on the same line. The
# secrets the servers use belong in the encrypted vault, secrets_vault.age.
set -uo pipefail

refused=0
while read -r old new ref; do
  [[ $new =~ ^0+$ ]] && continue
  if [[ $old =~ ^0+$ ]]; then
    range="$new --not --all"
  else
    range="$old..$new"
  fi
  if ! output=$(gitleaks detect --source . --config "${GITLEAKS_CONFIG:-/etc/gitleaks/systems_repository.toml}" --redact --no-banner --verbose --log-opts="-m $range" 2>&1); then
    printf '%s\n' "$output" >&2
    printf 'The main copy on util01 refused the push to %s: gitleaks found what looks like a secret in one of its commits (above, with the secret hidden), or gitleaks did not run.\n' "$ref" >&2
    refused=1
  fi
done
if [ "$refused" -ne 0 ]; then
  printf '%s\n' 'Nothing changed. Remove the secret from every commit (a later commit that deletes it leaves it in the history), put a real secret in the vault, or add a gitleaks:allow comment to a line that is no secret, then push again.' >&2
fi
exit "$refused"
