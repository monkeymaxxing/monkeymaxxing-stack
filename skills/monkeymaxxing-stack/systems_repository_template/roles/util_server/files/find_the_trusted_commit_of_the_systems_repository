#!/usr/bin/env bash
# Managed by MMX from roles/util_server. util01's scheduled jobs call this
# script in /var/lib/mmhotline/systems_repository, MMHotline's copy of the
# systems repository, before each job.
#
# MMHotline trusts every commit on origin (mmhotline_settings.yml,
# systems_repository_commits.trusted_commits: every_commit_on_origin), and origin is the
# main copy, a bare repository on util01 that only the keys in
# root_ssh_public_keys can push to. The script reads the commit that main
# ends at in the main copy and asks MMHotline to check through that commit:
# mmhotline commit-reviews check. MMHotline fetches into its copy and moves
# the copy's checkout forward to that commit. The script prints the commit,
# and the caller runs the job at the commit the copy has checked out. This
# script never moves the checkout.
#
# Order, so no lock waits for another forever: call this script WITHOUT
# holding /var/lib/mmhotline/systems_repository.lock, because the check
# takes that lock itself and waits for it without a time limit. Take the
# lock only after the script ends.
#
# Exit codes:
# 0  the commit is on standard output.
# 1  the main copy cannot be reached, the copy is broken, or MMHotline
#    answered but trusts no commit; nothing ran.
# 3  everyone is locked out: the lock-out button wrote
#    /etc/mmhotline/everyone-locked-out on util01, and only its undo removes
#    it (roles/everyone_locked_out). The caller runs nothing and exits 0:
#    the servers refuse util01's key during a lock-out, and a failed job
#    would only add a warning to the incident.
# 4  MMHotline refused the check, such as while its settings trust no
#    commit; nothing ran.
# Only when MMHotline does not answer at all (its command socket is missing
# or does not answer, as while MMHotline is stopped) does the script print
# the commit the copy already has, with one line that says so: the job
# runs nothing newer than what util01 ran before. An answer or a refusal
# from MMHotline never falls back to that commit, and the lock-out is
# checked again right before the fallback, so a lock-out that starts
# while the check waits never falls back to it either.
set -euo pipefail
LOCKED_OUT=/etc/mmhotline/everyone-locked-out
say() { printf 'find_the_trusted_commit_of_the_systems_repository: %s\n' "$*" >&2; }

if [ -e "$LOCKED_OUT" ]; then
  say "everyone is locked out ($LOCKED_OUT), so this job runs nothing until the person undoes the lock-out with the lock-out button"
  exit 3
fi

current=$(git rev-parse --verify --quiet 'HEAD^{commit}') || { say "util01's copy of the systems repository has no commit checked out; nothing ran"; exit 1; }
if ! head=$(git ls-remote --exit-code origin refs/heads/main) || [ -z "${head%%[[:space:]]*}" ]; then
  say "cannot read main in the main copy of the systems repository; nothing ran"
  exit 1
fi
head=${head%%[[:space:]]*}

status=0
errors=$(mktemp)
trap 'rm -f "$errors"' EXIT
answer=$(sudo -n /usr/local/bin/mmhotline commit-reviews check --commit-id "$head" --json 2> "$errors") || status=$?
if [ "$status" -le 1 ] && trusted=$(jq -er '.commit_check.trusted_through_commit_id | select(. != "")' <<< "$answer" 2> /dev/null); then
  printf '%s\n' "$trusted"
  exit 0
fi
cat "$errors" >&2
if [ -e "$LOCKED_OUT" ]; then
  say "everyone is locked out ($LOCKED_OUT), so this job runs nothing until the person undoes the lock-out with the lock-out button"
  exit 3
fi
# mmhotline exits 4 both for a refusal and for a command socket that does
# not answer; only its own words for the socket tell them apart.
if [ "$status" -eq 4 ] && grep -Eq 'mmhotline serve is not running at command socket|cannot reach mmhotline serve at command socket' "$errors"; then
  say "MMHotline did not answer the commit check; this job runs at the commit util01 already has, ${current:0:12}, and at nothing newer"
  printf '%s\n' "$current"
  exit 0
fi
if [ "$status" -eq 4 ]; then
  say "MMHotline refused the commit check of ${head:0:12}; nothing ran"
  exit 4
fi
say "MMHotline trusts no commit through ${head:0:12} (exit $status); nothing ran"
exit 1
