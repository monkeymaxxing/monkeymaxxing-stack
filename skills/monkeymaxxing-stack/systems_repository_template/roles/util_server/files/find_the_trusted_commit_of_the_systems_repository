#!/usr/bin/env bash
# Managed by MMX from roles/util_server. util01's scheduled jobs call this
# script in /var/lib/mmhotline/systems_repository, MMHotline's copy of the
# systems repository, before each job. A push alone must change no server:
# no person asks a scheduled job to run, so the jobs run only a commit that
# MMHotline trusts.
#
# MMHotline is the one place that decides which commit is trusted
# (mmhotline_settings.yml, triage_agent). The script reads the commit that
# main ends at on the Git host and asks MMHotline to check every new commit
# through that commit: mmhotline commit-reviews check. MMHotline fetches into
# its copy, sends one alert for each commit that newly waits for review,
# and moves the copy's checkout forward to the trusted commit, never past it.
# The script prints the trusted commit, and the caller runs the job at the
# commit the copy has checked out, which is the trusted commit or a newer
# trusted commit. This script never moves the checkout.
#
# Order, so no lock waits for another forever: call this script WITHOUT
# holding /var/lib/mmhotline/systems_repository.lock, because the check
# takes that lock itself and waits for it without a time limit. Take the
# lock only after the script ends.
#
# Exit codes:
# 0  the trusted commit is on standard output.
# 1  the Git host cannot be reached, or the copy is broken; nothing ran.
# 2  MMHotline trusts no commit of main yet; nothing ran. MMHotline's own
#    warning names each commit that waits for review, so the jobs end
#    without failing their unit, which would send a second, bare warning.
# When MMHotline does not answer, such as while MMHotline is stopped, the
# script prints the commit the copy already has, with one line that says
# so: the job runs nothing newer than what util01 ran before. During a
# lock-out, MMHotline's settings have no triage_agent section, which holds
# the keys it trusts (mmhotline_settings.yml), so MMHotline refuses the
# check; the one line then says that, in place of MMHotline's own error.
set -euo pipefail
SETTINGS=/etc/mmhotline/mmhotline_settings.yml
say() { printf 'find_the_trusted_commit_of_the_systems_repository: %s\n' "$*" >&2; }

current=$(git rev-parse --verify --quiet 'HEAD^{commit}') || { say "util01's copy of the systems repository has no commit checked out; nothing ran"; exit 1; }
if ! head=$(git ls-remote --exit-code origin refs/heads/main) || [ -z "${head%%[[:space:]]*}" ]; then
  say "cannot read main at the Git host; nothing ran"
  exit 1
fi
head=${head%%[[:space:]]*}

status=0
errors=$(mktemp)
trap 'rm -f "$errors"' EXIT
answer=$(sudo -n /usr/local/bin/mmhotline commit-reviews check --commit-id "$head" --json 2> "$errors") || status=$?
if [ "$status" -le 1 ] && checked=$(jq -er '.commit_check.checked_commit_id' <<< "$answer" 2> /dev/null); then
  trusted=$(jq -r '.commit_check.trusted_through_commit_id // ""' <<< "$answer")
  waiting=$(jq -r '.commit_check.commits_waiting_for_review | length' <<< "$answer")
  approvals=$(jq -r '(.web_url // "" | sub("/$"; "")) + "/approvals"' <<< "$answer")
  if [ -z "$trusted" ]; then
    say "MMHotline trusts no commit of main yet. Commits waiting for review: $waiting, at $approvals. Nothing ran"
    exit 2
  fi
  [ "$waiting" -eq 0 ] || say "commits waiting for review: $waiting, at $approvals. This job runs at the trusted commit ${trusted:0:12}, not at main's ${checked:0:12}"
  printf '%s\n' "$trusted"
  exit 0
fi
if [ -r "$SETTINGS" ] && ! grep -q '^triage_agent:' "$SETTINGS"; then
  say "MMHotline checks no commit during a lock-out, because its settings then hold no trusted keys; this job runs at the commit util01 already has, ${current:0:12}, and at nothing newer"
else
  cat "$errors" >&2
  say "MMHotline did not answer the commit check (exit $status); this job runs at the commit util01 already has, ${current:0:12}, and at nothing newer"
fi
printf '%s\n' "$current"
