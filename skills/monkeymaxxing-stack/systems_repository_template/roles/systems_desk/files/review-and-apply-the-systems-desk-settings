#!/usr/bin/python3
"""Review and apply this systems desk's settings: run playbooks/systems_desk.yml as root, after
the person reviews what changed in the desk playbook since their last review.

The coding agent pushes to main, and the desk playbook applies main as root on
the desk that holds the person's production key, phone-code secret and
tokens. So this command compares what the desk playbook would do now with what
the person last reviewed, and asks the person, in the person's own
terminal, only when something changed. The record of the last reviewed
desk playbook is root-only on this desk, outside the coding agent's reach.

What the desk playbook reads, and so what is compared, comes from MMX itself:
`mmx explain systems_desk --json` lists every node task of the run with its
resolved arguments and the rendered text of each template. To that this
command adds the files that tasks copy without rendering (file.source and
similar), the inventory's connection settings of the nodes the run
connects to, and the SSH settings and known-hosts files those name, because
OpenSSH runs commands from SSH settings. Line numbers and where each value
came from are left out, so moving a line or editing an unrelated setting
asks nothing.

The review also shows and records the keys in the project settings that
the lock-out button's undo lets in on every server, because the lock-out
button compares the pulled settings with that record.

It works in the desk's own copy of the systems repository,
/var/lib/systems-desk/systems_repository, root-only, which it makes pushed
main first, so it reviews and runs only what is pushed: main of the team's
main copy on util01, or, before util01 exists, main of the coding agent's
checkout, which is the main copy until then. The
bootstrap makes that copy and records the first desk review with
--record-the-first-desk-review: the person has nothing to compare it with.

Run it as yourself, in your own terminal on the desk (ssh desk01-review
from the laptop):
    review-and-apply-the-systems-desk-settings [--only-fleet-stages systems_desk]
"""
import datetime
import difflib
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import socket
import subprocess
import sys
import tempfile

INSTALLED_PATH = '/usr/local/bin/review-and-apply-the-systems-desk-settings'
MMX = '/usr/local/bin/mmx'
GIT = '/usr/bin/git'
# Reads pushed main without running Git in the coding agent's checkout.
FETCH_PUSHED_MAIN = '/usr/local/bin/fetch-pushed-main-from-the-coding-agents-checkout'
# The desk's own copy of pushed main, root-only, so neither the coding agent
# nor a program of the person's can change what is reviewed and run. Its
# .mmx keeps the desk reviews' run history.
DESK_COPY = Path('/var/lib/systems-desk/systems_repository')
# Where the bootstrap's copy of the systems repository is, which the desk
# copy starts from.
CODING_AGENT_CHECKOUT = Path('/home/coding-agent/systems_repository')
# Root's Git runs only in root's own repositories. It fetches pushed main
# from the main copy on util01 over SSH (pull_main_into_the_desks_copy), and
# before util01 exists from a copy of the coding agent's checkout
# (FETCH_PUSHED_MAIN), never with Git in the checkout.
GIT_ENVIRONMENT = {'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': '/root', 'LANG': 'C.UTF-8',
                   'GIT_CONFIG_GLOBAL': os.devnull}
# The coding agent's own Git, as its logins get it (sshd.conf). Root runs it
# only to ask whether the checkout has an origin, until root's first pull
# from util01, so root never runs Git inside the coding agent's checkout.
CODING_AGENT_GIT = ['/usr/sbin/runuser', '-u', 'coding-agent', '--', GIT, '-c', 'core.hooksPath=/dev/null']
CODING_AGENT_GIT_ENVIRONMENT = {'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': '/home/coding-agent', 'LANG': 'C.UTF-8',
                                'SSH_AUTH_SOCK': '/run/desk-ssh-agent/socket',
                                'GIT_CONFIG_SYSTEM': '/etc/systems-desk/coding-agent-gitconfig'}
# The person's private agent socket: root may use it, and the desk playbook
# reads util01's join code through it.
PRIVATE_AGENT_SOCKET = '/run/desk-ssh-agent/private.sock'
# Root-only, so the coding agent can neither read nor change what the
# person reviewed.
RECORD_DIRECTORY = Path('/var/lib/systems-desk/reviewed-desk-refresh')
PLAYBOOK = 'systems_desk'
ACCOUNTS_THAT_ARE_NOT_A_PERSON = {'root', 'coding-agent', 'servers-mmx'}
# Inventory fields that MMX's explain output does not show, but that decide
# how MMX connects to a node. Files they name are shown by content.
CONNECTION_FILE_FIELDS = ('ssh_config', 'ssh_known_hosts')
# Files the review does not show. ssh/known_hosts gains a line with every
# server added, so showing it would make each new server a change to review,
# and the desk review should be rare. A host key line only says which key to
# trust for a server: it runs no command and lets nobody in. The lock-out
# button takes it from the pull as data for the same reason.
FILES_NOT_SHOWN = {'ssh/known_hosts'}
# The project settings that the lock-out button installs on every server as
# SSH keys when everyone_locked_out_except_desk is removed, the undo: root's
# authorized keys, and the triage user's key. The lock-out press itself lets in
# only the key of the desk that keeps access. The servers' keys and addresses
# in the inventory the lock-out button shows at each press.
SETTINGS_THE_BUTTON_LETS_IN = ('root_ssh_public_keys', 'triage_ssh_public_key')


class Stop(Exception):
    """A reason to stop before anything ran. Nothing was recorded."""


def visible(text):
    """Shows control and invisible characters as escapes, so a pushed file
    cannot move the cursor, recolor, or hide a line in the review."""
    out = []
    for character in text:
        if character.isprintable():
            out.append(character)
        elif character == '\t':
            out.append('\\t')
        else:
            out.append('\\u%04x' % ord(character) if ord(character) > 0xff else '\\x%02x' % ord(character))
    return ''.join(out)


def block(text, indent='    | '):
    return [indent + visible(line) for line in text.split('\n')]


def value_lines(field, value):
    """A value as lines. YAML values that JSON lacks, such as dates, are
    shown as text."""
    field = visible(str(field))
    if isinstance(value, str) and '\n' in value:
        return ['  %s:' % field] + block(value)
    if isinstance(value, (dict, list)) and value:
        rendered = json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False, default=str)
        return ['  %s:' % field] + ['    ' + visible(line) for line in rendered.split('\n')]
    return ['  %s: %s' % (field, visible(json.dumps(value, ensure_ascii=False, default=str)))]


def inside(repository, path):
    """The path, with every symbolic link followed, if it stays inside the
    repository. MMX reads the target, and a target outside the repository
    could change after the review."""
    resolved = path.resolve()
    if resolved != repository and repository not in resolved.parents:
        raise Stop('%s points outside the systems repository, to %s. The desk playbook reads only files inside '
                   'the repository, so remove that link. Nothing ran.' % (path.relative_to(repository), resolved))
    return resolved


def file_lines(repository, path):
    resolved = inside(repository, path)
    name = shown_name(repository, path)
    if name in FILES_NOT_SHOWN:
        return []
    if resolved.is_dir():
        lines = []
        for child in sorted(resolved.rglob('*')):
            if child.is_file() or child.is_symlink():
                lines += file_lines(repository, path/child.relative_to(resolved))
        return lines
    data = resolved.read_bytes()
    try:
        return ['File %s:' % name] + block(data.decode('utf-8'))
    except UnicodeDecodeError:
        return ['File %s: binary, %d bytes, sha256 %s' % (name, len(data), hashlib.sha256(data).hexdigest())]


def shown_name(repository, path):
    return os.path.normpath(path.relative_to(repository).as_posix())


# The arguments through which MMX reads a file of the controller machine:
# source, template, signing_key_source, package_file_source and
# key_files_on_controller_machine. A field such as
# shell.run_only_once_marker_file names a file on the desk instead.
CONTROLLER_FILE_ARGUMENT = re.compile(r'(source|template|[a-z_]+_source|key_files_on_controller_machine(\[\d+\])?)')


def refuse_a_path_outside_the_repository(repository, base, where, value):
    """Stops the desk review when a file the desk playbook reads is named
    by an absolute path, or by a relative one that leaves the repository.
    Reason: the review shows only files of the repository, so such a file
    could change after the person's yes, and the next desk review would run
    it as root without a question. Same kind of Stop as inside()."""
    if value.startswith('/') or not os.path.normpath(base/value).startswith(str(repository) + os.sep):
        raise Stop('%s names %s, a path outside the systems repository. The desk playbook reads only files inside '
                   'the repository, which your review shows: name the file by its path inside the repository. '
                   'Nothing ran.' % (where, visible(value)))


def referenced_files(repository, task):
    """Repository files a task copies as they are, named by an argument
    such as file.source or apt_repository.signing_key_source. A template's
    rendered text is already in the explain output, so templates are
    skipped. Other arguments, such as a service named ssh, name no file."""
    rendered = {template['field'] for template in task.get('rendered_templates', [])}
    bases = [repository]
    source = task.get('source', {}).get('file')
    if source:
        bases.insert(0, (repository/source).parent)
    for argument in task.get('arguments', []):
        value = argument.get('value')
        last = argument['field'].rsplit('.', 1)[-1]
        if CONTROLLER_FILE_ARGUMENT.fullmatch(last) and isinstance(value, str) and value and '{{' not in value:
            refuse_a_path_outside_the_repository(repository, bases[0], 'Task %s, argument %s,' % (
                visible(task.get('path', '')), visible(argument['field'])), value)
        if not any(word in last for word in ('source', 'template', 'file')):
            continue
        if (argument['field'] in rendered or not isinstance(value, str) or not value or '\n' in value
                or value.startswith('/') or '{{' in value or len(value) > 1024):
            continue
        for base in bases:
            candidate = base/value
            if (candidate.exists() or candidate.is_symlink()) and candidate.resolve() != repository:
                yield candidate
                break


def refuse_ssh_settings_includes(repository, path):
    """Stops the desk review when the desk's SSH settings file has an Include
    line. OpenSSH reads an included file only when root or the user running
    ssh owns it, and root runs the desk playbook, so an included file in the
    person's repository never works there; a root-owned file outside the
    repository could change after the review. The settings belong in the
    file itself, which the review shows."""
    for number, line in enumerate(inside(repository, path).read_text(errors='replace').split('\n'), 1):
        if re.match(r'\s*include(\s*=|\s)', line, re.IGNORECASE):
            raise Stop('%s, line %d, has an Include line. The desk playbook takes its SSH settings only from that file, '
                       'so your review sees every setting: put the included settings into %s itself and remove the '
                       'Include line. Nothing ran.' % (shown_name(repository, path), number, shown_name(repository, path)))


def desk_run_view(repository, explain, inventory):
    """Everything the desk playbook does, one line per fact, in a stable order."""
    lines = []
    files = {}
    nodes = []
    for path in ['mmx_project_settings.yml', 'inventories', 'playbooks/%s.yml' % PLAYBOOK]:
        inside(repository, repository/path)
    for stage in explain['fleet_stages']:
        lines.append('Fleet stage %s on %s, selected by %s' % (
            visible(stage['path']), visible(', '.join(stage['nodes'])), visible(json.dumps(stage['selection']))))
        nodes += [node for node in stage['nodes'] if node not in nodes]
        for task in stage['node_tasks']:
            source = task.get('source', {}).get('file')
            if source:
                inside(repository, repository/source)
            module = 'external_modules/' + task['action']
            if (repository/module).exists():
                files[module] = file_lines(repository, repository/module)
            lines.append('Task %s on %s: %s, %s' % tuple(visible(task.get(key, '')) for key in ('path', 'node', 'action', 'status')))
            for argument in task.get('arguments', []) + task.get('timing', []):
                lines += value_lines(argument['field'], argument.get('value'))
            for template in task.get('rendered_templates', []):
                if 'text' in template:
                    lines += ['  %s renders as:' % visible(template['field'])] + block(template['text'])
                else:
                    lines.append('  %s does not render: %s' % (visible(template['field']), visible(template.get('not_rendered_because', ''))))
            for path in referenced_files(repository, task):
                files[shown_name(repository, path)] = file_lines(repository, path)
    for node in nodes:
        settings = {key: value for key, value in (inventory.get('nodes', {}).get(node) or {}).items() if key != 'vars'}
        lines.append('Connection settings of %s in the inventory' % visible(node))
        for key in sorted(settings):
            lines += value_lines(key, settings[key])
            value = settings[key]
            if key in CONNECTION_FILE_FIELDS and isinstance(value, str):
                refuse_a_path_outside_the_repository(repository, repository, 'The inventory\'s %s of %s' % (key, visible(node)), value)
                path = repository/value
                if path.exists() or path.is_symlink():
                    files[shown_name(repository, path)] = file_lines(repository, path)
                if key == 'ssh_config' and path.is_file():
                    refuse_ssh_settings_includes(repository, path)
    for name in sorted(files):
        lines += files[name]
    return lines


def lock_out_button_keys_view(settings):
    """The keys of SETTINGS_THE_BUTTON_LETS_IN in the project settings, one
    line each, sorted, so a reordered list is no change."""
    variables = settings.get('vars') or {}
    lines = ['Keys in mmx_project_settings.yml that the lock-out button lets in']
    for name in SETTINGS_THE_BUTTON_LETS_IN:
        value = variables.get(name)
        values = value if isinstance(value, list) else [value]
        lines += sorted('  %s: %s' % (name, visible(item if isinstance(item, str) else json.dumps(item, default=str)))
                        for item in values)
    return lines


def changes(old, new):
    """A unified diff whose hunks name the task or file they are in."""
    def header(lines, start, end):
        """The task, file or server the change is in: a header line the
        change adds or removes, else the one above the change."""
        for line in lines[start:end] + list(reversed(lines[:start + 1])):
            if not line.startswith(' '):
                return line
        return '(start)'
    out = []
    matcher = difflib.SequenceMatcher(a=old, b=new, autojunk=False)
    for group in matcher.get_grouped_opcodes(3):
        tag, i1, i2, j1, j2 = next(opcode for opcode in group if opcode[0] != 'equal')
        out.append('@@ ' + (header(new, j1, j2) if tag != 'delete' else header(old, i1, i2)))
        for tag, i1, i2, j1, j2 in group:
            if tag == 'equal':
                out += ['  ' + line for line in old[i1:i2]]
            if tag in ('replace', 'delete'):
                out += ['- ' + line for line in old[i1:i2]]
            if tag in ('replace', 'insert'):
                out += ['+ ' + line for line in new[j1:j2]]
    return out


def git(repository, *arguments):
    """Root's Git in the desk copy, with hooks off: no pushed file runs."""
    return subprocess.run([GIT, '-c', 'core.hooksPath=/dev/null', *arguments], cwd=repository, text=True,
                          capture_output=True, env=GIT_ENVIRONMENT)


def current_commit(repository):
    head = git(repository, 'rev-parse', 'HEAD')
    return head.stdout.strip() if head.returncode == 0 else 'no commit yet'


# The longest the pull from the main copy on util01 may take. Reason: long
# enough for a slow connection; short, because the lock-out button goes on
# without the pull, and a break-in must not wait for util01.
PULL_TIME_LIMIT_SECONDS = 30


def as_the_coding_agent(*arguments):
    """Git as coding-agent, with no terminal: standard input is /dev/null,
    output and errors go to pipes, and a new session has no controlling
    terminal, so /dev/tty does not open either. Reason: coding-agent's own
    Git settings run its programs (core.sshCommand), and one that held the
    person's terminal could repaint the diff or type the answer."""
    return subprocess.run(['timeout', '--kill-after=5', str(PULL_TIME_LIMIT_SECONDS), *CODING_AGENT_GIT,
                           '-C', str(CODING_AGENT_CHECKOUT), *arguments],
                          text=True, capture_output=True, stdin=subprocess.DEVNULL, start_new_session=True,
                          env=CODING_AGENT_GIT_ENVIRONMENT)


# Root-owned, in the desk copy's .git: written at the first pull that
# finds util01, so the coding agent cannot turn root back to its checkout
# by removing the checkout's origin.
PUSHED_MAIN_COMES_FROM_UTIL01 = '.git/pushed-main-comes-from-util01'


def main_copy_url(repository, revision):
    """The main copy on util01, as root reaches it over SSH: util01's
    address and SSH user from the inventory, and
    systems_repository.main_copy_path_on_util01 from the settings, at
    revision of the desk copy: HEAD, pushed main as root last fetched it,
    or on a copy with no commit yet the checkout's main just read as data.
    Never the coding agent's remote.origin.url."""
    import yaml  # python3-yaml, which the desk role installs

    def read(name):
        shown = git(repository, 'show', '%s:%s' % (revision, name))
        if shown.returncode:
            raise Stop('%s is missing at %s' % (name, revision))
        loaded = yaml.safe_load(shown.stdout)
        return loaded if isinstance(loaded, dict) else {}
    settings = read('mmx_project_settings.yml')
    variables = settings.get('vars') if isinstance(settings.get('vars'), dict) else {}
    path = (variables.get('systems_repository') or {}).get('main_copy_path_on_util01')
    inventory = read('inventories/%s.yml' % settings.get('default_inventory', ''))
    nodes = ((inventory.get('groups') or {}).get('util_server') or {}).get('nodes') or ['']
    node = (inventory.get('nodes') or {}).get(nodes[0]) or {}
    address, user = node.get('address'), node.get('ssh_user') or 'root'
    for value in (path, address, user):
        if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z0-9_./-]+', value) or value.startswith('-'):
            raise Stop('the desk copy names no main copy on util01 that root can reach (util01\'s address %s, ssh_user %s, '
                       'main_copy_path_on_util01 %s)' % (visible(str(address)), visible(str(user)), visible(str(path))))
    return '%s@%s:%s' % (user, address, path)


def ssh_to_the_main_copy(known_hosts):
    """Root's SSH to the main copy on util01: the production key through the
    person's private agent socket, as the desk playbook reads util01's join
    code, and only the host keys in known_hosts."""
    return ('ssh -F /dev/null -o IdentityAgent=%s -o IdentityFile=/etc/systems-desk/production_key.pub -o IdentitiesOnly=yes '
            '-o UserKnownHostsFile=%s -o GlobalKnownHostsFile=/dev/null -o StrictHostKeyChecking=yes -o BatchMode=yes '
            '-o ForwardAgent=no -o ClearAllForwardings=yes -o ConnectTimeout=10' % (PRIVATE_AGENT_SOCKET, known_hosts))


def pull_main_into_the_desks_copy(repository=DESK_COPY, at_the_bootstrap=False):
    """Makes the desk copy pushed main: fetch, then reset, keeping only the
    run history in .mmx. Returns whether the pull worked, and one plain
    sentence that says what happened or what is in the way.

    Pushed main is main of the main copy on util01, which root fetches
    itself, into this root-owned copy, with main_copy_url's address. Root
    never reads a ref the coding agent writes for it, so every commit root
    runs is in the main copy's log of main.

    Before util01 exists, the coding agent's checkout has no origin and is
    the main copy, so its own main is pushed main, which root reads as data
    (FETCH_PUSHED_MAIN). The first pull that finds an origin in the checkout
    writes PUSHED_MAIN_COMES_FROM_UTIL01, and from then on root fetches from
    util01 only, also while util01 is lost: a desk review then waits for
    the new util01, and the lock-out button goes on with the copy it has.
    at_the_bootstrap, for --record-the-first-desk-review only, reads the
    checkout and leaves no mark. Reason: until the lock, the laptop that runs
    the bootstrap is root on the desk anyway, and a desk rebuilt while
    util01 is lost must still finish its bootstrap
    (operating_procedures/rebuild_a_systems_desk.md).
    util01's host key comes from ssh/known_hosts of both the desk copy and
    the checkout's main, so a rebuilt util01's committed key works."""
    if not (repository/'.git').is_dir():
        # A desk from an earlier Stack version, whose desk reviews ran in the
        # person's own checkout, gets its desk copy at its first such pull.
        repository.mkdir(mode=0o700, parents=True, exist_ok=True)
        repository.chmod(0o700)
        git(repository, 'init', '--quiet', '-b', 'main')
    marker = repository/PUSHED_MAIN_COMES_FROM_UTIL01
    from_util01 = marker.exists() or (not at_the_bootstrap and as_the_coding_agent('remote', 'get-url', 'origin').returncode == 0)
    # Root reads the checkout, which coding-agent owns, as data only.
    fetched = subprocess.run([FETCH_PUSHED_MAIN, str(CODING_AGENT_CHECKOUT), str(repository)], text=True, capture_output=True,
                             env=GIT_ENVIRONMENT)
    if not from_util01 and fetched.returncode:
        return False, visible(' '.join(fetched.stderr.split()) or 'The fetch of pushed main did not work.')
    if from_util01:
        has_head = git(repository, 'rev-parse', '--verify', '--quiet', 'HEAD').returncode == 0
        checkout_main = 'FETCH_HEAD' if fetched.returncode == 0 else None
        known_hosts = ''.join(git(repository, 'show', '%s:ssh/known_hosts' % revision).stdout + '\n'
                              for revision in ('HEAD' if has_head else None, checkout_main) if revision)
        try:
            revision = 'HEAD' if has_head else checkout_main
            if not revision:
                raise Stop('the desk copy has no commit yet, and the checkout\'s main could not be read')
            url = main_copy_url(repository, revision)
        except Stop as stop:
            return False, 'The pull of main from the main copy on util01 did not work (%s).' % stop
        with tempfile.NamedTemporaryFile('w', prefix='util01-known-hosts-') as hosts:
            hosts.write(known_hosts)
            hosts.flush()
            fetched = subprocess.run(['timeout', '--kill-after=5', str(PULL_TIME_LIMIT_SECONDS), GIT, '-c', 'core.hooksPath=/dev/null',
                                      '-C', str(repository), 'fetch', '--quiet', '--no-tags', '--', url, 'main'],
                                     text=True, capture_output=True, stdin=subprocess.DEVNULL,
                                     env={**GIT_ENVIRONMENT, 'GIT_SSH_COMMAND': ssh_to_the_main_copy(hosts.name)})
        if fetched.returncode:
            said = ' '.join((fetched.stderr or fetched.stdout).split())[:400] or 'no message'
            if fetched.returncode in (124, 137):
                cause = 'util01 did not answer within %d seconds' % PULL_TIME_LIMIT_SECONDS
            else:
                cause = 'git said: %s' % visible(said)
            return False, 'The pull of main from the main copy on util01 did not work (%s).' % cause
        marker.write_text('Root fetches pushed main from the main copy on util01 (review-and-apply-the-systems-desk-settings).\n')
    for arguments in [('reset', '--quiet', '--hard', 'FETCH_HEAD'), ('clean', '--quiet', '-d', '--force', '-x', '--exclude=.mmx')]:
        done = git(repository, *arguments)
        if done.returncode:
            return False, 'git %s in %s did not work: %s' % (arguments[0], repository, visible(' '.join(done.stderr.split())[:400]))
    if from_util01:
        return True, 'Pulled main from the main copy on util01: the desk\'s copy is at %s.' % current_commit(repository)
    return True, ('Pulled main from the coding agent\'s checkout, the main copy until util01 exists: the desk\'s copy is at %s.'
                  % current_commit(repository))


def read_record(name='desk_run_view'):
    """The recorded view, desk_run_view or lock_out_button_keys_view, and
    the commit it was reviewed at."""
    try:
        return ((RECORD_DIRECTORY/name).read_text().split('\n'),
                (RECORD_DIRECTORY/'commit').read_text().strip())
    except FileNotFoundError:
        return None, None


def write_record(view, commit, keys_view):
    RECORD_DIRECTORY.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chown(RECORD_DIRECTORY, 0, 0)
    RECORD_DIRECTORY.chmod(0o700)
    now = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%d %H:%M UTC')
    for name, text in [('desk_run_view', '\n'.join(view)), ('lock_out_button_keys_view', '\n'.join(keys_view)),
                       ('commit', '%s, reviewed %s\n' % (commit, now))]:
        with tempfile.NamedTemporaryFile('w', dir=RECORD_DIRECTORY, delete=False) as out:
            out.write(text)
        os.chmod(out.name, 0o600)
        os.replace(out.name, RECORD_DIRECTORY/name)


def ask_the_person(question):
    """Reads the answer from the terminal of the person who ran this
    command, never from a pipe: only the person types into that terminal."""
    try:
        # Unbuffered: a terminal cannot seek, which a buffered read-write file needs.
        terminal = open('/dev/tty', 'rb+', buffering=0)
    except OSError:
        raise Stop('review-and-apply-the-systems-desk-settings asks you a question, so run it in your own desk terminal. Nothing ran.')
    with terminal:
        terminal.write(question.encode())
        return terminal.readline().decode(errors='replace').strip()


def show(lines):
    if sys.stdout.isatty():
        colors = {'@': '36', '-': '31', '+': '32'}
        lines = ['\033[%sm%s\033[0m' % (colors[line[0]], line) if line[:1] in colors else line for line in lines]
    text = '\n'.join(lines) + '\n'
    rows = shutil.get_terminal_size((80, 24)).lines
    if sys.stdout.isatty() and len(lines) > rows - 8 and shutil.which('less'):
        # LESSSECURE turns off less's shell commands and file opening.
        subprocess.run(['less', '-R', '-F', '-X'], input=text, text=True, env={'LESSSECURE': '1', 'PATH': '/usr/bin:/bin'})
    else:
        sys.stdout.write(text)
        sys.stdout.flush()


def review(view, commit):
    """True when the person agreed to run this view, or nothing changed."""
    old, old_commit = read_record()
    if old == view:
        print('What the desk playbook does is the same as at your last desk review (%s). Running it now.' % old_commit, flush=True)
        return True
    if old is None:
        print('This desk has no desk review yet, so there is nothing to compare with.')
        print('This desk review records what the desk playbook does at %s as reviewed. Later desk reviews show only what changed.' % commit)
        print('If this desk replaces another desk, check the recent commits on main with your team first.')
        answer = ask_the_person('Type yes to run the desk playbook and record it as reviewed, or press Enter to stop: ')
        return answer.lower() == 'yes'
    diff = changes(old, view)
    print('What the desk playbook does changed since your last desk review (%s).' % old_commit)
    print('This desk review runs as root on this desk, where your production key, phone-code secret and tokens are.')
    print('Your coding agent, your teammates and util01 can push changes to it, so read each change before you agree;')
    print('your coding agent explains each change it pushed.')
    print('Lines with - are what the desk playbook did at your last review; lines with + are what this run would do.')
    print('Each @@ line names the task or file the change is in.')
    print(flush=True)
    show(diff)
    removed = sum(1 for line in diff if line.startswith('- '))
    added = sum(1 for line in diff if line.startswith('+ '))
    print('%d lines removed and %d added. If a change is not one you expect, stop and ask your team' % (removed, added))
    print('or your coding agent what it is for, before you run it.')
    answer = ask_the_person('Type yes to run the changed desk playbook as root, or press Enter to stop: ')
    return answer.lower() == 'yes'


def what_the_desk_playbook_does(repository):
    """The view of the desk playbook in repository, and its part that the
    lock-out button compares with: what a desk review shows and records."""
    import yaml  # python3-yaml, which the desk role installs
    explained = subprocess.run([MMX, 'explain', PLAYBOOK, '--var', 'desk_name=' + socket.gethostname(), '--json'],
                               cwd=repository, text=True, capture_output=True,
                               env={'PATH': '/usr/local/bin:/usr/bin:/bin', 'HOME': '/root', 'LANG': 'C.UTF-8'})
    if explained.returncode:
        raise Stop('mmx explain could not read the desk playbook:\n%s\nNothing ran.' % explained.stderr.strip())
    settings = yaml.safe_load((repository/'mmx_project_settings.yml').read_text()) or {}
    inventory_path = repository/'inventories'/(str(settings.get('default_inventory', '')) + '.yml')
    inventory = yaml.safe_load(inside(repository, inventory_path).read_text()) or {}
    keys_view = lock_out_button_keys_view(settings)
    return desk_run_view(repository, json.loads(explained.stdout), inventory) + keys_view, keys_view


def record_the_first_desk_review():
    """The bootstrap's step, as root, before the lock: makes the desk copy
    from the coding agent's checkout, the main copy until util01 exists, and
    records what the desk playbook does there as reviewed. Returns 2 when
    it recorded, 0 when this desk has a desk review already."""
    if os.geteuid() != 0 or os.environ.get('SUDO_USER'):
        raise Stop('--record-the-first-desk-review is the bootstrap\'s step, run by the desk playbook as root. Nothing ran.')
    if read_record()[0] is not None:
        return 0
    DESK_COPY.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    pulled, reason = pull_main_into_the_desks_copy(DESK_COPY, at_the_bootstrap=True)
    if not pulled:
        raise Stop('The desk copy could not be made from %s: %s' % (CODING_AGENT_CHECKOUT, reason))
    view, keys_view = what_the_desk_playbook_does(DESK_COPY)
    write_record(view, '%s, recorded by the bootstrap' % current_commit(DESK_COPY), keys_view)
    print('Recorded the first desk review at %s. Later desk reviews show only what changed since.' % current_commit(DESK_COPY))
    return 2


def main(arguments):
    if arguments == ['--record-the-first-desk-review']:
        return record_the_first_desk_review()
    only = []
    if arguments[:1] == ['--only-fleet-stages'] and len(arguments) == 2 and re.fullmatch(r'[a-z0-9_]+(,[a-z0-9_]+)*', arguments[1]):
        only = arguments
    elif arguments:
        raise Stop('Usage: review-and-apply-the-systems-desk-settings [--only-fleet-stages systems_desk]. Nothing ran.')
    if os.geteuid() != 0:
        os.execv('/usr/bin/sudo', ['sudo', '--', INSTALLED_PATH, *arguments])
    person = os.environ.get('SUDO_USER', '')
    if not person or person in ACCOUNTS_THAT_ARE_NOT_A_PERSON:
        raise Stop('Run review-and-apply-the-systems-desk-settings as yourself, without sudo, in your own terminal. Nothing ran.')
    repository = DESK_COPY
    pulled, reason = pull_main_into_the_desks_copy(repository)
    print(reason, flush=True)
    if not pulled:
        # Nothing about a desk review is urgent, so it reviews only what is
        # pushed; the lock-out button goes on instead.
        raise Stop('Stopped before the review. Ask your coding agent why the pull did not work, '
                   'then run review-and-apply-the-systems-desk-settings again. Nothing ran.')
    view, keys_view = what_the_desk_playbook_does(repository)
    commit = current_commit(repository)
    if not review(view, commit):
        raise Stop('Stopped. Nothing ran, and nothing was recorded.')
    write_record(view, commit, keys_view)
    command = [MMX, 'run', PLAYBOOK, '--var', 'desk_name=' + socket.gethostname(), *only, '--connection', 'ssh_only']
    print(' '.join(command), flush=True)
    os.chdir(repository)
    os.execve(MMX, command, {**os.environ, 'SSH_AUTH_SOCK': PRIVATE_AGENT_SOCKET})


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except Stop as stop:
        print(stop, file=sys.stderr)
        sys.exit(1)
