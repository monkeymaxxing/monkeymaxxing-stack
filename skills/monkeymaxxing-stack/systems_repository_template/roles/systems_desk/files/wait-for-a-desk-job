#!/bin/bash
# Waits for a desk job and returns its exit code. It reads only the job's
# two files: ~/runs/NAME.log, its output, and ~/runs/NAME.exit, which the
# job writes when it ends, with its exit code or a line that says why it
# ended without one. The coding agent runs, from the laptop:
#     ssh desk01-agent wait-for-a-desk-job NAME [--at-most-minutes N]
# It prints a few lines of the job's log when the log grows, at most every
# 30 seconds, and a line at least once a minute, so the login is never
# idle. The last line says how the job ended.
# Exit codes:
#     the job's own exit code   the job ended by itself
#     124                       the job still runs; the wait ended at its bound
#     125                       the job ended without an exit code, such as when the desk stopped it
#     64                        a wrong argument; nothing was waited for
#     66                        no desk job with this name ran
# Reason for the bound, 9 minutes by default: Claude Code stops a command
# after 10 minutes, so the wait ends first and says so. A coding agent that
# allows longer commands passes --at-most-minutes. A wait that ends early
# changes nothing: the job runs on, and the same command waits again.
set -euo pipefail
export PATH=/usr/local/bin:/usr/bin:/bin
runs=/home/coding-agent/runs
seconds_between_checks=5
seconds_between_log_lines=30
seconds_between_lines_at_most=60
# Reason: the command that starts a job returns before the job's first line, so a wait
# started at once may find no log for a moment.
seconds_to_find_a_new_job=30

refuse() { printf '%s Nothing was waited for.\n' "$1" >&2; exit 64; }
usage='Usage: wait-for-a-desk-job NAME [--at-most-minutes N], where NAME is the name you gave the desk job.'
[ "$#" = 1 ] || [ "$#" = 3 ] || refuse "$usage"
name=$1
at_most_minutes=9
if [ "$#" = 3 ]; then
    [ "$2" = --at-most-minutes ] || refuse "$usage"
    [[ "$3" =~ ^[1-9][0-9]{0,2}$ ]] || refuse "--at-most-minutes takes a whole number of minutes from 1 to 999, not $3."
    at_most_minutes=$3
fi
# The rule for desk job names: no path, no option, nothing a file name cannot hold.
[[ "$name" =~ ^[a-z0-9][a-z0-9_-]{0,63}$ ]] ||
    refuse "The job name $name may hold only lowercase letters, digits, - and _, such as every-server-2026-11-17-1405."
log=$runs/$name.log
exit_file=$runs/$name.exit

started=$(date +%s)
last_line_at=$started
shown_log_size=0
log_size() { if [ -f "$log" ]; then wc -c < "$log" | tr -d ' '; else echo 0; fi; }
minutes_waited() { echo $(( ($(date +%s) - started) / 60 )); }

while [ ! -f "$exit_file" ]; do
    now=$(date +%s)
    if [ ! -e "$log" ] && [ $((now - started)) -ge "$seconds_to_find_a_new_job" ]; then
        printf 'No systems desk job named %s ran on this systems desk: %s does not exist. ls ~/runs lists the jobs.\n' "$name" "$log"
        exit 66
    fi
    if [ $((now - started)) -ge $((at_most_minutes * 60)) ]; then
        printf 'The systems desk job %s still runs after %s minutes. It carries on by itself; wait again with: wait-for-a-desk-job %s\n' \
            "$name" "$at_most_minutes" "$name"
        exit 124
    fi
    size=$(log_size)
    if [ "$size" != "$shown_log_size" ] && [ $((now - last_line_at)) -ge "$seconds_between_log_lines" ]; then
        printf -- '--- %s runs (%s min); the last lines of its log:\n' "$name" "$(minutes_waited)"
        tail -n 5 -- "$log" | cut -c1-300
        shown_log_size=$size
        last_line_at=$now
    elif [ $((now - last_line_at)) -ge "$seconds_between_lines_at_most" ]; then
        printf -- '--- %s runs (%s min); its log has not changed.\n' "$name" "$(minutes_waited)"
        last_line_at=$now
    fi
    sleep "$seconds_between_checks"
done

printf -- '--- The last lines of the log of %s:\n' "$name"
[ -f "$log" ] && tail -n 30 -- "$log" | cut -c1-300
ended_with=$(head -n 1 -- "$exit_file")
if [[ "$ended_with" =~ ^[0-9]{1,3}$ ]] && [ "$ended_with" -le 255 ]; then
    # Not "failed": an MMX dryrun's exit code 2 means proposed changes.
    printf 'The systems desk job %s ended with exit code %s. Its log is %s.\n' "$name" "$ended_with" "$log"
    exit "$ended_with"
fi
printf 'The systems desk job %s ended without an exit code. Its exit file says: %s\n' "$name" "$ended_with"
exit 125
