#!/bin/bash
# Sets up the desk's one phone code, which every outside login of the
# person and of coding-agent asks for (sshd_pam). No secret passes through
# MMX. Run as root, from the person's terminal:
#     sudo -n set-up-the-phone-code --emergency-codes-to PATH
# It shows the QR code and asks for a code from the phone until one matches,
# as the lock's step 3 of 3, your phone code, goes on (set-up-outside-services
# lock-the-desk prints that screen's title and its lines 1 and 2). Only after the
# code matches it writes the secret to /etc/systems-desk/phone-code (root:root
# 0400) and the emergency codes to PATH (0600, owned by the person who ran
# sudo), for the recovery bundle. The secret itself goes nowhere else.
#
#     sudo -n set-up-the-phone-code --replace-emergency-codes < CODES
# gives the phone code that is set up the new emergency codes on standard
# input, one per line. The secret and the option lines stay, so the phone
# needs no new scan, and the old emergency codes stop working.
# set-up-outside-services make-a-new-recovery-bundle runs it, after a lost
# recovery passphrase, once the new recovery bundle holding the codes is safe.
set -euo pipefail
umask 077
code_file=/etc/systems-desk/phone-code
# The number of one-time emergency codes, for a lost phone.
emergency_code_count=5
usage='Usage: sudo -n set-up-the-phone-code --emergency-codes-to PATH | --replace-emergency-codes < CODES'
if [ "$(id -u)" != 0 ]; then
    printf 'set-up-the-phone-code writes a root-owned file. %s\n' "$usage" >&2
    exit 1
fi

if [ "$#" -eq 1 ] && [ "$1" = --replace-emergency-codes ]; then
    if [ ! -f "$code_file" ]; then
        printf 'This systems desk has no phone code yet, in %s. Nothing changed.\n' "$code_file" >&2
        exit 1
    fi
    new_codes=$(cat)
    # 8 digits that do not start with 0, as google-authenticator makes them.
    if [ "$(grep -cxE '[1-9][0-9]{7}' <<< "$new_codes" || true)" != "$emergency_code_count" ] ||
        [ "$(wc -l <<< "$new_codes")" -ne "$emergency_code_count" ]; then
        printf 'Standard input is not %s emergency codes of 8 digits, one per line. Nothing changed.\n' "$emergency_code_count" >&2
        exit 1
    fi
    # A failed read must stop here: a file built from nothing would drop the
    # phone's secret and lock the person out.
    if ! old=$(cat -- "$code_file"); then
        printf 'Reading %s failed. Nothing changed.\n' "$code_file" >&2
        exit 1
    fi
    secret_line=$(head -n 1 <<< "$old")
    if ! [[ "$secret_line" =~ ^[A-Z2-7]+=*$ ]]; then
        printf '%s does not start with the phone'"'"'s secret. Nothing changed.\n' "$code_file" >&2
        exit 1
    fi
    kept_lines=$(grep -vxE '[0-9]{8}' <<< "$old")
    pending_file=$(mktemp /etc/systems-desk/.phone-code-new-emergency-codes.XXXXXXXX)
    trap 'rm -f -- "$pending_file"' EXIT
    # The secret and the option lines stay as they are; only the code lines change.
    printf '%s\n%s\n' "$kept_lines" "$new_codes" > "$pending_file"
    # Checked before the swap: the secret first, every other line of the
    # old file kept, and the new codes.
    if [ "$(head -n 1 "$pending_file")" != "$secret_line" ] ||
        [ "$(grep -vxE '[0-9]{8}' "$pending_file")" != "$kept_lines" ] ||
        [ "$(grep -xE '[0-9]{8}' "$pending_file")" != "$new_codes" ]; then
        printf 'The new %s would not keep the phone'"'"'s secret and options. Nothing changed.\n' "$code_file" >&2
        exit 1
    fi
    chmod 0400 "$pending_file"
    mv -f -- "$pending_file" "$code_file"
    printf 'Gave your phone code %s new emergency codes. Your phone keeps working as before.\n' "$emergency_code_count"
    exit 0
fi

if [ "$#" -ne 2 ] || [ "$1" != --emergency-codes-to ] || [ -z "$2" ]; then
    printf '%s\n' "$usage" >&2
    exit 64
fi
emergency_codes_file=$2
if [ -e "$emergency_codes_file" ] || [ -L "$emergency_codes_file" ]; then
    printf '%s already exists. Name a new file for the emergency codes. Nothing changed.\n' "$emergency_codes_file" >&2
    exit 1
fi
owner=${SUDO_UID:-0}:${SUDO_GID:-0}

if [ -e "$code_file" ]; then
    printf 'This systems desk'"'"'s phone code is already set up, in %s. Nothing changed.\n' "$code_file" >&2
    exit 1
fi
pending_file=$(mktemp /etc/systems-desk/.phone-code-setup.XXXXXXXX)
# Clears the screen and its scrollback, so the secret does not stay there.
clear_the_secret_from_the_screen() { printf '\033[3J\033[H\033[2J'; }
secret_on_screen=no
trap 'rm -f -- "$pending_file"; [ "$secret_on_screen" = no ] || clear_the_secret_from_the_screen' EXIT
# --rate-limit=3 --rate-time=30: at most three login tries every 30 seconds,
# one phone code's lifetime, so a guesser gets three codes per code shown
# while the person, who types one code, never meets the limit; fail2ban's
# lockout (phone_code_jail.conf) ends the guessing. --window-size=3 accepts
# the code before and after the current one, for a phone clock 30 seconds off.
# --emergency-codes: one-time codes for a lost phone, which go into the
# recovery bundle.
# google-authenticator draws the QR code only on a terminal, so script(1)
# gives it one while this command keeps its output.
generated=$(script --quiet --return --command "google-authenticator --time-based --disallow-reuse \
    --rate-limit=3 --rate-time=30 --window-size=3 --emergency-codes=$emergency_code_count --qr-mode=UTF8 --force --no-confirm \
    --secret=$pending_file" /dev/null)
secret=$(head -n 1 "$pending_file")
secret_on_screen=yes
# Only the QR code, whose rows alone start with a colour code. The program's
# other lines name a website that would show the secret, print a code that
# works now, and list the emergency codes, which go to the recovery bundle.
printf '%s\n' "$generated" | grep -a "^$(printf '\033')\[" || true
printf '\n  Or type this key into the app instead:  %s\n\n' "$secret"
printf '  3. Type the 6 digits your phone shows.\n\n'

code_matches() {
    local typed=$1 now offset
    [[ "$typed" =~ ^[0-9]{6}$ ]] || return 1
    now=$(date +%s)
    for offset in -30 0 30; do
        [ "$typed" = "$(oathtool --totp --base32 --now="@$((now + offset))" - <<< "$secret")" ] && return 0
    done
    return 1
}
# Asks again after a wrong code, as long as the person keeps typing: the
# person is at the desk already, so a guess here opens nothing. Ctrl-C or
# the end of input stops it, with nothing saved.
while :; do
    read -r -p '  Code: ' typed_code || exit 1
    code_matches "$typed_code" && break
    printf '\n  That code did not match.  Type the 6 digits your phone shows now.\n  If every code fails, check that your phone sets its clock automatically.\n\n'
done
clear_the_secret_from_the_screen
secret_on_screen=no
# The emergency codes first, then the secret: a desk that asks for a code
# always has its emergency codes saved.
grep -E '^[0-9]{8}$' "$pending_file" | install -o "${owner%:*}" -g "${owner#*:}" -m 0600 /dev/stdin "$emergency_codes_file"
# A hard link publishes the confirmed file without replacing an enrollment
# made at the same moment. The pending name is removed on exit.
if ! ln -- "$pending_file" "$code_file"; then
    rm -f -- "$emergency_codes_file"
    exit 1
fi
chmod 0400 "$code_file"
printf 'Your phone code is ready. From now on each new login to this systems desk needs your laptop AND a code from your phone.\n'
printf 'Each code works once. %s wrong codes within ten minutes lock that laptop out of the systems desk for %s minutes.\n' '{{ .inputs.phone_code_lockout.wrong_codes_before_lockout }}' '{{ .inputs.phone_code_lockout.lockout_minutes }}'
