# The API proxy for the server provider. On 127.0.0.1:8081 it adds the
# person's server provider token, or signs the request, and forwards it to
# the provider's API. Cloudflare has its own service, cloudflare-api-proxy.
# Reason for two services: each starts once its own file exists, so this
# port answers before the Cloudflare token does; the setup creates the
# servers through this port first. Only this service reads the provider's
# token or credential file (roles/systems_desk/main.yml, provider_api_proxy).
[Unit]
Description=API proxy for the server provider on 127.0.0.1:8081
Wants=network-online.target
After=network-online.target

[Service]
{{- if eq .inputs.provider_api_authentication "token_in_a_header" }}
ExecStart=/usr/local/lib/set-up-outside-services/releases/{{ .inputs.set_up_outside_services_release.version }}/set-up-outside-services run-the-provider-api-proxy --api server-provider --provider-api-url {{ .inputs.provider_api_url }}
LoadCredential=provider-api-token:/etc/systems-desk/provider-api-token.conf
{{- else }}
ExecStart=/usr/local/lib/set-up-outside-services/releases/{{ .inputs.set_up_outside_services_release.version }}/set-up-outside-services run-the-provider-api-proxy --api server-provider
LoadCredential=provider-api-signing-credential:/etc/systems-desk/provider-api-signing-credential.json
{{- end }}
LoadCredential=desk-server-id:/etc/systems-desk/desk-server-id
LoadCredential=desk-server-name:/etc/systems-desk/desk-server-name
DynamicUser=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
