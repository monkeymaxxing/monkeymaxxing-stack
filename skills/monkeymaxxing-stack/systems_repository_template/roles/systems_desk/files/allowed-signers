# Managed by MMX from the systems_desk role: the keys in root_ssh_public_keys
# (mmx_project_settings.yml) at this desk's last desk review, one per line,
# named by the key's comment, such as alex_on_desk01 for "alex on desk01".
# Git reads this file to verify commit signatures
# (gpg.ssh.allowedSignersFile), so git log --show-signature names the desk
# that signed each commit.
{{- range .inputs.root_ssh_public_keys }}
{{- $fields := splitList " " (trim .) }}
{{ if gt (len $fields) 2 }}{{ regexReplaceAll "[^A-Za-z0-9.@-]+" (slice $fields 2 | join " ") "_" }}{{ else }}root_ssh_public_keys{{ end }} {{ index $fields 0 }} {{ index $fields 1 }}
{{- end }}
