#!/bin/bash
# Starts this desk's coding agent, {{ .inputs.systems_desk_coding_agent }},
# as the coding-agent account, in its checkout of the systems repository.
# The person runs it in their own desk terminal, with any arguments for the
# coding agent:
#     start-the-coding-agent
# systems_desk_coding_agent in mmx_project_settings.yml picks the coding
# agent; the desk review writes this file from
# roles/systems_desk/files/start-the-coding-agent.
set -euo pipefail
if [ "$(id -un)" != coding-agent ]; then
  exec sudo -u coding-agent -i /usr/local/bin/start-the-coding-agent "$@"
fi
cd ~/systems_repository
{{- if eq .inputs.systems_desk_coding_agent "codex" }}
exec codex "$@"
{{- else }}
exec claude "$@"
{{- end }}
