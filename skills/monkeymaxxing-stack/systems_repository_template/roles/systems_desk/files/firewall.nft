#!/usr/sbin/nft -f
# Replace only our table: fail2ban owns its separate table and live bans.
# The prototype's nftables firewall also works during the bootstrap handoff;
# ufw's controller-source safeguard rejects the deliberate closing of that path.
table inet systems_desk {}
flush table inet systems_desk
table inet systems_desk {
    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept
        ct state established,related accept
        iifname "wg0" ip saddr {{ .inputs.systems_desk_laptop_addresses }} tcp dport 22 accept
        # The redirect (wireguard_udp_443_redirect.nft) turns UDP 443 into the
        # WireGuard port before this chain sees the packet.
        iifname != "wg0" udp dport {{ .inputs.wireguard_listen_port }} accept
        # DHCP renews the provider network lease; it is never a private service.
        iifname != "wg0" udp sport 67 udp dport 68 accept
        iifname != "wg0" udp sport 547 udp dport 546 accept
        # ICMP carries path-MTU errors and IPv6 neighbour discovery.
        ip protocol icmp accept
        meta l4proto ipv6-icmp accept
    }
    chain forward {
        type filter hook forward priority 0; policy drop;
    }
    # servers-mmx, the account of the MMX button (run-mmx-on-the-servers),
    # never reaches this desk's own SSH. A connection to any address of this
    # desk, loopback, wg0 or public, leaves through lo. Reason: a pushed
    # inventory or ssh_config can name this desk under any address or
    # HostName, and the button's runs offer the production key. sshd
    # accepts that key for no account here; this rule keeps the desk closed
    # to the button even if an authorized_keys file ever changes.
    chain output {
        type filter hook output priority 0; policy accept;
        oifname "lo" meta skuid "servers-mmx" tcp dport 22 reject with tcp reset
    }
}
