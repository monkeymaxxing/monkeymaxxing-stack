{{- /*
  An app's database settings direct to Postgres, at its own port 5432, for
  what needs a whole Postgres session, which PgBouncer's transaction mode
  doesn't keep: /etc/<app>/<app>_database_direct_to_postgres.env, mode 0600,
  root, on the app servers, staging01, and the jobs servers (roles/app_server
  and roles/jobs_server). The migrations read it after the app's secrets
  file, and so does the app's job container when the app's
  jobs_connect_directly_to_postgres is true, so these two settings win over
  the secrets file's, which name
  PgBouncer's port once the app's environment connects through it. It reads
  the loop variable app and the role inputs database_servers and
  app_secrets, as app_secrets.env does, and its URLs are that file's at
  Postgres's port.
*/ -}}
{{- $database_name := .app.value.database_name -}}
{{- $password_name := printf "%s_database_password" $database_name -}}
{{- $database_hosts := list -}}
{{- /* Reads also require a writable login during the move, so an unfinished replica cannot answer them. */ -}}
{{- $moving := get .inputs "database_moving_in" | default dict -}}
{{- $this_app_moves := and $moving (has .app.key $moving.apps) -}}
{{- if $this_app_moves -}}
{{- $database_hosts = append $database_hosts (printf "%s:%v" $moving.wireguard_address $moving.postgres_port) -}}
{{- end -}}
{{- range .inputs.database_servers -}}{{- $database_hosts = append $database_hosts (printf "%s:5432" .) -}}{{- end -}}
# Managed by MMX: {{ .app.key }}'s database settings direct to Postgres, from
# the vault. MMX hides this file's content in its output and results.
DATABASE_URL=postgresql://{{ $database_name }}:{{ index .inputs.app_secrets $password_name }}@{{ join "," $database_hosts }}/{{ $database_name }}?target_session_attrs=read-write&connect_timeout=3
DATABASE_READ_URL=postgresql://{{ $database_name }}:{{ index .inputs.app_secrets $password_name }}@{{ join "," $database_hosts }}/{{ $database_name }}?target_session_attrs={{ if $this_app_moves }}read-write{{ else }}prefer-standby{{ end }}&connect_timeout=3
