{{- /*
  An app's plain settings, read by its containers' EnvironmentFile= and by
  its migrations. It reads the loop variable app and the role input
  is_staging_server. On staging01, each name in the app's staging_env
  replaces the same name in its env, so staging01 never gets production's
  value for it.
*/ -}}
# Managed by MMX from apps.{{ .app.key }}.env{{ if .inputs.is_staging_server }} and staging_env{{ end }} in mmx_project_settings.yml.
# Podman reads each line as NAME=value and takes the value exactly as written.
{{- $settings := .app.value.env }}
{{- /* Range over the app's keys: MMX refuses to read staging_env directly when an app leaves it out. */ -}}
{{- if .inputs.is_staging_server }}{{ range $key, $staging := .app.value }}{{ if eq $key "staging_env" }}{{ $settings = merge (dict) $staging $settings }}{{ end }}{{ end }}{{ end }}
{{- range $name, $value := $settings }}
{{ $name }}={{ $value }}
{{- end }}
