{{- /*
  An app's plain settings, read by its containers' EnvironmentFile= and by
  its migrations. It reads the loop variable app and the role input
  is_staging_server.

  R2_BUCKET comes only from the bucket settings: production_uploads_r2_bucket,
  or on staging01 staging_uploads_r2_bucket, when that value is not "". The
  uploads' nightly copy reads the same setting, so the app and the copy
  cannot name different buckets. On staging01, each name in the app's
  staging_env replaces the same name in its env. every_server refuses an
  app whose env or staging_env names R2_BUCKET.

  MMX refuses to read a key an app leaves out, so the template ranges over
  the app's keys to find staging_env and staging_uploads_r2_bucket.
*/ -}}
# Managed by MMX from apps.{{ .app.key }}.env{{ if .inputs.is_staging_server }}, staging_env, staging_uploads_r2_bucket{{ else }}, production_uploads_r2_bucket{{ end }} in mmx_project_settings.yml.
# Podman reads each line as NAME=value and takes the value exactly as written.
{{- $settings := merge (dict) .app.value.env }}
{{- $bucket := .app.value.production_uploads_r2_bucket }}
{{- if .inputs.is_staging_server }}
{{- $bucket = "" }}
{{- range $key, $staging := .app.value }}
{{- if eq $key "staging_env" }}{{ $settings = merge (dict) $staging $settings }}{{ end }}
{{- if eq $key "staging_uploads_r2_bucket" }}{{ $bucket = $staging }}{{ end }}
{{- end }}
{{- end }}
{{- if ne $bucket "" }}{{ $_ := set $settings "R2_BUCKET" $bucket }}{{ end }}
{{- range $name, $value := $settings }}
{{ $name }}={{ $value }}
{{- end }}
