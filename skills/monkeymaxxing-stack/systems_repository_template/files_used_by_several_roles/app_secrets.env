{{- /*
  An app's secrets, read by its containers' EnvironmentFile= and by its
  migrations: /etc/<app>/<app>.env, mode 0600, root, on the app servers,
  staging01, and the jobs servers (roles/app_server and roles/jobs_server).
  It reads the loop variable app and the role inputs database_servers,
  apps_connect_through_pgbouncer, and app_secrets, which holds
  <database_name>_database_password and <app>_<VARIABLE> for each name in
  the app's secrets_from_vault, a mapping from each name to where its value
  comes from, which only the setup reads. A name missing from app_secrets fails the
  run and names it.

  DATABASE_URL lists every database server, so the Postgres driver finds the
  primary by itself after a failover (target_session_attrs=read-write), and
  a database server added to the inventory is in it at the next run. Each
  server gets 3 seconds to answer (connect_timeout=3, which libpq and pgx
  apply to each server in turn): a switched-off server answers nothing, and
  without a limit the driver waits minutes for it before trying the next. The
  Postgres role has the database's name. The password is letters and digits,
  so it needs no escaping in the URL.

  DATABASE_READ_URL is the same, but prefers a replica
  (target_session_attrs=prefer-standby), for an app that sends reads there
  which may be a moment behind the primary. With one database server, or
  when no replica answers, it reaches the primary.

  Each server's port is Postgres's own, 5432, or PgBouncer's, 6432, when
  this environment's apps connect through PgBouncer: the driver finds the
  primary through the PgBouncers as it does without them. The migrations,
  and a job container whose jobs need a whole Postgres session, read
  app_database_direct_to_postgres.env after this file, whose same two
  settings always name Postgres's port.
*/ -}}
{{- $app_name := .app.key -}}
{{- $database_name := .app.value.database_name -}}
{{- $password_name := printf "%s_database_password" $database_name -}}
{{- if not (hasKey .inputs.app_secrets $password_name) }}{{ fail (printf "the role input app_secrets has no %s: add it to the role call's app_secrets in playbooks/every_server.yml" $password_name) }}{{ end -}}
{{- $port := ternary 6432 5432 .inputs.apps_connect_through_pgbouncer -}}
{{- $database_hosts := list -}}
{{- /* Reads also require a writable login during the move, so an unfinished replica cannot answer them. */ -}}
{{- $moving := get .inputs "database_moving_in" | default dict -}}
{{- $this_app_moves := and $moving (has .app.key $moving.apps) -}}
{{- if $this_app_moves -}}
{{- $database_hosts = append $database_hosts (printf "%s:%v" $moving.wireguard_address $moving.postgres_port) -}}
{{- end -}}
{{- range .inputs.database_servers -}}{{- $database_hosts = append $database_hosts (printf "%s:%d" . $port) -}}{{- end -}}
# Managed by MMX: {{ $app_name }}'s secrets, from the vault. MMX hides this
# file's content in its output and results.
DATABASE_URL=postgresql://{{ $database_name }}:{{ index .inputs.app_secrets $password_name }}@{{ join "," $database_hosts }}/{{ $database_name }}?target_session_attrs=read-write&connect_timeout=3
DATABASE_READ_URL=postgresql://{{ $database_name }}:{{ index .inputs.app_secrets $password_name }}@{{ join "," $database_hosts }}/{{ $database_name }}?target_session_attrs={{ if $this_app_moves }}read-write{{ else }}prefer-standby{{ end }}&connect_timeout=3
{{- if not (kindIs "map" .app.value.secrets_from_vault) }}{{ fail (printf "vars.apps.%s.secrets_from_vault in mmx_project_settings.yml is a list: write it as a mapping that names where each value comes from, as the template's example app does" $app_name) }}{{ end }}
{{- range $variable, $source := .app.value.secrets_from_vault }}
{{- $name := printf "%s_%s" $app_name $variable }}
{{- if not (hasKey $.inputs.app_secrets $name) }}{{ fail (printf "the role input app_secrets has no %s: add it to the role call's app_secrets in playbooks/every_server.yml" $name) }}{{ end }}
{{ $variable }}={{ index $.inputs.app_secrets $name }}
{{- end }}
