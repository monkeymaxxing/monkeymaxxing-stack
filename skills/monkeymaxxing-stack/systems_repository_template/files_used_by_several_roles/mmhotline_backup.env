# Managed by MMX from the systems repository (playbooks/every_server.yml, the
# fleet stage mmhotline). Litestream copies MMHotline's database to this
# bucket as it changes (mmhotline-backup.service, which MMHotline writes). The
# address is backups.mmhotline_backup_replica_url in mmx_project_settings.yml,
# the two keys come from the vault, and only root reads this file.
MMHOTLINE_BACKUP_REPLICA_URL="{{ .vars.backups.mmhotline_backup_replica_url }}"
LITESTREAM_ACCESS_KEY_ID="{{ .secrets.mmhotline_backup_access_key_id }}"
LITESTREAM_SECRET_ACCESS_KEY="{{ .secrets.mmhotline_backup_secret_access_key }}"
